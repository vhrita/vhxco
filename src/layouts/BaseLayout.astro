---
import '../styles/global.css';
import NeuralEngineIsland from '@/components/hero/NeuralEngineIsland';
import HeroFallback from '@/components/hero/HeroFallback.astro';
import CustomCursor from '@/components/cursor/CustomCursor';
import Preloader from '@/components/effects/Preloader.astro';
import HudCorners from '@/components/hud/HudCorners.astro';
import TopNav from '@/components/hud/TopNav.astro';
import HudWaveform from '@/components/hud/HudWaveform';
import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';

export interface Props {
  title: string;
  description?: string;
  locale?: 'pt' | 'en';
}

const {
  title,
  description = 'VHXCO — Agentic Software House',
  locale = 'pt',
} = Astro.props;

const t = getT(locale as Locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <!-- a11y: skip to main content (always first in DOM) -->
    <a href="#main" class="skip-link">{t('a11y.skipToContent')}</a>

    <Preloader />
    <NeuralEngineIsland client:only="react" />
    <CustomCursor client:idle />
    <!-- iter-08 Move B: MuteButton now rendered inside TopNav (right-most element) -->
    <noscript><HeroFallback /></noscript>

    <!-- HUD layer (z-index: var(--z-hud)) -->
    <TopNav locale={locale} />
    <HudCorners />
    <!-- HudWaveform React island: appends its own canvas after idle hydration -->
    <HudWaveform client:idle />

    <main id="main">
      <slot />
    </main>

    <!--
      QA iter-07: scroll-cue moved back inline into PhaseCore.astro (last child
      of .core-content). Iter-04..06 used position:fixed at body level which
      caused the chip to occlude paragraphs. Inline placement lets the cue flow
      naturally at the foot of the core content and scrolls with it.
      The subscribePhase script below still writes `data-active-phase` on the
      body — kept because other future chrome may depend on it.
    -->

    <script>
      // Audio lazy-init gate — loads audio chunk only after first user click.
      import('@/lib/audio/lazy-init');

      // Boot-complete audio hook — fires audioBoot() when bootProgress reaches 1.0,
      // but only if the audio module has already been loaded (user clicked at least once).
      // This covers the "user clicked during preloader" path.
      import('@/lib/neural-engine/boot-progress').then(({ bootProgress }) => {
        let _bootFired = false;
        bootProgress.subscribe((v) => {
          if (_bootFired || v < 1.0) return;
          _bootFired = true;
          const audio = (window as unknown as Record<string, unknown>).__audioReady as
            | { audioBoot: () => void }
            | undefined;
          audio?.audioBoot();
        });
      });
    </script>
    <script>
      // Mount scroll/phase orchestrator after hydration.
      // On phase change, fire audioSwoosh() + update ambient tuning via __audioReady.
      import('@/lib/scroll/phase-orchestrator').then(
        ({
          createPhaseOrchestrator,
          getPhaseState,
          subscribePhase,
          getTargetProgress,
        }) => {
          const orchestrator = createPhaseOrchestrator();

          // QA iter-04 (Issue #1): write active phase to body dataset so global
          // chrome (scroll-cue, etc.) can target CSS at the right phase.
          // Initialize at phase 0 — PhaseCore boots with data-active="true".
          document.body.dataset.activePhase = '0';
          subscribePhase((state) => {
            document.body.dataset.activePhase = String(state.phase);
          });

          // Audio phase hook — fires on every phase transition
          let _lastAudioPhase = -1;
          subscribePhase((state) => {
            if (state.phase === _lastAudioPhase) return;
            _lastAudioPhase = state.phase;

            const audio = (window as unknown as Record<string, unknown>).__audioReady as
              | {
                  audioSwoosh: () => void;
                  setPhase: (n: 0 | 1 | 2 | 3 | 4) => void;
                  isMuted: () => boolean;
                }
              | undefined;

            if (!audio || audio.isMuted()) return;
            audio.setPhase(state.phase as 0 | 1 | 2 | 3 | 4);
            audio.audioSwoosh();
          });

          // Dev-only global for debugging: window.__phaseStore.getState()
          if (import.meta.env.DEV) {
            (window as unknown as Record<string, unknown>).__phaseStore = {
              getState: getPhaseState,
              subscribe: subscribePhase,
              getTargetProgress,
              goToPhase: orchestrator.goToPhase.bind(orchestrator),
            };
          }

          // HUD nav buttons dispatch hud:goto-phase — wired to orchestrator here
          window.addEventListener('hud:goto-phase', (e: Event) => {
            const phase = (e as CustomEvent<{ phase: number }>).detail.phase;
            orchestrator.goToPhase(phase);
          });
        }
      );
    </script>
  </body>
</html>
