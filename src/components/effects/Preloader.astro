---
/**
 * Preloader.astro
 *
 * 3.8s cinematic boot sequence overlay.
 * Ported from v0 VHXCO.html:1671-1686 + vhxco-app.js:1040-1083.
 *
 * Key behaviors:
 *   - 6 boot steps cycling at ~633ms each (TOTAL_MS / steps.length)
 *   - Fill bar CSS transition kicks off immediately (var(--dur-ambient) = 1600ms)
 *   - bootProgress store updated each RAF frame (0 → 1 over TOTAL_MS)
 *   - Engine shaders read bootProgress via subscribe in render-loop.ts
 *   - prefers-reduced-motion: jump to fade-out in 200ms, no scramble animation
 *   - Scramble effect on [data-scramble] headings after preloader fades
 */
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// i18n — fallback strings if keys are missing (future-proof)
const line1 = t('preloader.line1') ?? 'VHXCO // SYNAPSE OS';
const line2 = t('preloader.line2') ?? 'Initializing operational consciousness';
---

<div id="preloader" aria-hidden="true" role="presentation">
  <div class="pre-mark">
    <div class="ring r3"></div>
    <div class="ring r2"></div>
    <div class="ring"></div>
    <div class="core"></div>
  </div>
  <div class="pre-meta">
    <div>{line1}</div>
    <div>{line2}</div>
  </div>
  <div class="pre-bar">
    <div class="fill" id="preFill"></div>
  </div>
  <div class="pre-systems" id="preSys">BOOT.0 → kernel_init</div>
</div>

<!-- White flash overlay — triggered at boot completion -->
<div id="preFlash" aria-hidden="true"></div>

<script>
  // ── Preloader boot logic ────────────────────────────────────────────────
  // Ported from vhxco-app.js:1040-1083.
  // Uses bootProgress store (boot-progress.ts) instead of window.bootProgress.

  import { bootProgress } from '@/lib/neural-engine/boot-progress';

  const TOTAL_MS = 3800;

  // Boot steps — sci-fi terminal style, language-agnostic (vhxco-app.js:1067-1074)
  const BOOT_STEPS = [
    'BOOT.0 → kernel_init',
    'BOOT.1 → vector_db_connect',
    'BOOT.2 → genesis_sequence_start',
    'BOOT.3 → isolated_synapse_test',
    'BOOT.4 → massive_neurogenesis',
    'READY → synaptic_handoff',
  ] as const;

  // Char pool for scramble effect
  const SCRAMBLE_CHARS =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=[]{}|;:',.<>?/~`";

  // ── Reduced-motion detection ────────────────────────────────────────────
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── DOM refs ────────────────────────────────────────────────────────────
  const preEl = document.getElementById('preloader');
  const fillEl = document.getElementById('preFill');
  const sysEl = document.getElementById('preSys');
  const flashEl = document.getElementById('preFlash');

  if (!preEl) {
    // Safety: if preloader element is gone for any reason, bail
    // (can happen in SSG/static island edge cases)
    throw new Error('[Preloader] #preloader not found');
  }

  // ── Scramble helper ─────────────────────────────────────────────────────
  // Shuffles characters of a text element, then resolves to the real text.
  // duration: total time to settle all characters (spread staggered).
  function scrambleHeading(el: HTMLElement, durationMs: number): void {
    if (reducedMotion) {
      // Reduced motion: simple fade-in via opacity transition
      el.style.opacity = '0';
      requestAnimationFrame(() => {
        el.style.transition = `opacity 400ms ease`;
        el.style.opacity = '1';
      });
      return;
    }

    const original = el.textContent ?? '';
    const chars = original.split('');
    const settled = new Array(chars.length).fill(false);
    const startTime = performance.now();

    function tick(now: number): void {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / durationMs, 1);

      // Stagger settlement: each char settles at its own progress threshold
      let allDone = true;
      const result = chars.map((ch, i) => {
        if (ch === ' ' || ch === '\n') return ch;
        const threshold = (i + 1) / chars.length;
        if (progress >= threshold || settled[i]) {
          settled[i] = true;
          return ch;
        }
        allDone = false;
        return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
      });

      el.textContent = result.join('');

      if (!allDone) {
        requestAnimationFrame(tick);
      } else {
        el.textContent = original; // guarantee final state
      }
    }

    requestAnimationFrame(tick);
  }

  // ── Boot step ticker ────────────────────────────────────────────────────
  let stepIdx = 0;
  function tickSys(): void {
    if (!sysEl) return;
    const step = BOOT_STEPS[stepIdx] ?? '';
    sysEl.innerHTML = `<span class="ok">&#x25CF;</span> ${step}`;
    stepIdx++;
    if (stepIdx < BOOT_STEPS.length) {
      setTimeout(tickSys, TOTAL_MS / BOOT_STEPS.length);
    }
  }

  // ── Completion handler ──────────────────────────────────────────────────
  function onBootComplete(): void {
    // Trigger white flash
    if (flashEl) {
      flashEl.classList.add('flash');
    }

    // Fade-out preloader
    preEl!.classList.add('done');

    // Scramble headings after preloader fades (~400ms delay)
    const delay = reducedMotion ? 0 : 400;
    setTimeout(() => {
      const targets = document.querySelectorAll<HTMLElement>('[data-scramble]');
      targets.forEach((el, i) => {
        // Stagger each heading: 600-1200ms duration spread across elements
        const duration = 600 + (i * 100);
        scrambleHeading(el, duration);
      });
    }, delay);
  }

  // ── Main boot tick ──────────────────────────────────────────────────────
  // Reduced motion: skip animation, complete in 200ms
  if (reducedMotion) {
    bootProgress.set(1.0);
    setTimeout(onBootComplete, 200);
  } else {
    const start = performance.now();

    // Kick off fill bar via CSS transition (width 0 → 100% over --dur-ambient)
    requestAnimationFrame(() => {
      if (fillEl) fillEl.style.width = '100%';
    });

    // Start boot step cycling
    tickSys();

    // RAF loop: update bootProgress store each frame
    function tickBoot(now: number): void {
      const elapsed = now - start;
      const progress = Math.min(elapsed / TOTAL_MS, 1.0);

      bootProgress.set(progress);

      if (progress < 1.0) {
        requestAnimationFrame(tickBoot);
      } else {
        onBootComplete();
      }
    }
    requestAnimationFrame(tickBoot);
  }
</script>
