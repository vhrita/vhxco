---
/**
 * EcoCard.astro — Reusable product card for Phase 03 Ecosystem
 *
 * Renders a single product entry with title, type badge, description, and
 * stack badges. Four corner decorations signal active/premium status.
 *
 * Props:
 *   name      — product name (translated)
 *   typeBadge — type label e.g. "B2C / Mobile App" (translated)
 *   desc      — product description (translated)
 *   stack     — array of tech stack labels (hard-coded, not translated)
 *   index     — 0-based position for --extract-index stagger delay
 *
 * Corner decorations:
 *   Four <span> elements (.corner-tl/tr/bl/br) rendered as L-shaped hairlines
 *   using CSS ::before + ::after. Ported from v0 VHXCO.html:1721-1722.
 *
 * Extractable cascade:
 *   data-extractable-index + --extract-index drive the extractIn stagger
 *   defined in global.css §10/§11. Phase[data-active] triggers animation.
 */

export interface Props {
  name: string;
  typeBadge: string;
  desc: string;
  stack: string[];
  index: number;
}

const { name, typeBadge, desc, stack, index } = Astro.props;
---

<article
  class="eco-card extractable"
  data-extractable-index={index}
  style={`--extract-index: ${index};`}
>
  <span class="corner-tl" aria-hidden="true"></span>
  <span class="corner-tr" aria-hidden="true"></span>
  <span class="corner-bl" aria-hidden="true"></span>
  <span class="corner-br" aria-hidden="true"></span>

  <h3 class="eco-title">{name}</h3>
  <p class="eco-type-badge">{typeBadge}</p>
  <p class="eco-desc">{desc}</p>
  <ul class="eco-stack" aria-label="Stack">
    {stack.map((badge) => <li>{badge}</li>)}
  </ul>
</article>
