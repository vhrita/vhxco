---
/**
 * PhaseEngineering.astro — Phase 02 / Engenharia (Branches)
 *
 * Displays the engineering phase with eyebrow, h2, and a 3-column grid of
 * NodeCard components (Workforce / Foundation / Diagnostic).
 *
 * Migrated from v0 VHXCO.html:1701-1709 + vhxco-app.js:682-805.
 * v0 used absolute positioning + JS layoutNodes() — replaced with CSS Grid.
 *
 * Extractable cascade:
 *   Each NodeCard receives data-extractable-index="N" and --extract-index: N.
 *   The .phase[data-active] state triggers extractIn animation with stagger:
 *     animation-delay: calc(var(--extract-index) * 160ms)
 *   Both .branches-header and each .node-card participate in the cascade.
 *
 * i18n strategy:
 *   - eyebrow: from src/i18n/ui.ts (useTranslations — flat dict)
 *   - h2 + node content: from src/lib/i18n/locales/*.json (getT — nested JSON)
 *
 * Phase orchestrator:
 *   - data-phase="1" observed by createPhaseOrchestrator (reduced-motion mode)
 *   - data-active toggled by subscribePhase() listener in script
 */

import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';
import NodeCard from './NodeCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tLocale = getT(lang as Locale);

// Flat dict (ui.ts) — eyebrow
const eyebrow = t('engineering.eyebrow');

// JSON locale — h2 and node content
const h2 = tLocale('engineering.h2');

// Node 1 — Workforce
const n1Num   = tLocale('engineering.n1.num');
const n1Title = tLocale('engineering.n1.title');
const n1Desc  = tLocale('engineering.n1.desc');

// Node 2 — Foundation
const n2Num   = tLocale('engineering.n2.num');
const n2Title = tLocale('engineering.n2.title');
const n2Desc  = tLocale('engineering.n2.desc');

// Node 3 — Diagnostic
const n3Num   = tLocale('engineering.n3.num');
const n3Title = tLocale('engineering.n3.title');
const n3Desc  = tLocale('engineering.n3.desc');
---

<section
  id="phase-branches"
  class="phase phase-engineering"
  data-phase="1"
  role="region"
  aria-labelledby="eng-heading"
>
  <div class="eng-content">
    <div class="branches-header extractable" data-extractable-index="0" style="--extract-index: 0;">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="eng-heading" class="headline eng-headline" set:html={h2} />
    </div>

    <div class="nodes-grid">
      <NodeCard
        num={n1Num}
        title={n1Title}
        desc={n1Desc}
        stack={["CLAUDE", "AI AGENTS", "AUTOMATION"]}
        glyph="intelligence"
        index={1}
      />
      <NodeCard
        num={n2Num}
        title={n2Title}
        desc={n2Desc}
        stack={["NODE.JS", "NEXT.JS", "REACT NATIVE"]}
        glyph="structure"
        index={2}
      />
      <NodeCard
        num={n3Num}
        title={n3Title}
        desc={n3Desc}
        stack={["BPMN", "CAPROVER", "POSTGRESQL"]}
        glyph="presence"
        index={3}
      />
    </div>
  </div>
</section>

<script>
  /**
   * Phase 02 client-side behaviour:
   *
   * data-active: subscribe to phase-orchestrator store. Toggle data-active
   * on the section when phase === 1. CSS transitions + extractIn animations
   * are gated on [data-active] presence.
   */
  import { subscribePhase } from '@/lib/scroll/phase-orchestrator';

  const section = document.getElementById('phase-branches');

  if (section) {
    subscribePhase(({ phase }) => {
      if (phase === 1) {
        section.dataset.active = 'true';
      } else {
        delete section.dataset.active;
      }
    });
  }
</script>
