---
/**
 * PhaseDataRoom.astro — Phase 04 / Sala de Dados (Data Room)
 *
 * Scrollytelling phase that presents proof-of-concept metrics:
 *   - Eyebrow + h2 section header
 *   - 3×2 grid of MetricCell components (6 KPIs, animated counters)
 *   - LogTable: 6 rows of decorative agent activity
 *
 * Bugs fixed vs v0:
 *   - metrics.2.delta: "▲ ATIVO" / "▲ ACTIVE" now correctly i18n'd
 *   - metrics.4.delta: "▲ LIVE" → "▼ -47%" (semantics fixed: reduction)
 *
 * Counter animation:
 *   - Handled inside MetricCell.astro script (IntersectionObserver + rAF)
 *   - 1400ms ease-out cubic (1 - (1-t)³)
 *   - prefers-reduced-motion: jumps to final value immediately
 *
 * Phase orchestrator:
 *   - data-phase="3" observed by createPhaseOrchestrator
 *   - data-active toggled by subscribePhase() listener below
 *
 * Migrated from v0: VHXCO.html:1744-1752 + vhxco-app.js:807-890
 */

import { getLangFromUrl } from '@/i18n/utils';
import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';
import MetricCell from './MetricCell.astro';
import LogTable from './LogTable.astro';

const lang = getLangFromUrl(Astro.url);
const t = getT(lang as Locale);

const eyebrow = t('dataRoom.eyebrow');
const h2 = t('dataRoom.h2');

// Metric data from i18n
const metrics = [
  {
    key: '1',
    label: t('dataRoom.metrics.1.label'),
    delta: t('dataRoom.metrics.1.delta'),
    value: 312,
    valueSuffix: '%',
    divisor: 1,
    foot: t('dataRoom.metrics.1.foot'),
    // Uptrend sparkline (rising left-to-right)
    sparkPath: 'M0,30 L20,28 L40,24 L60,22 L80,18 L100,20 L120,14 L140,10 L160,8 L180,4 L200,2',
  },
  {
    key: '2',
    label: t('dataRoom.metrics.2.label'),
    delta: t('dataRoom.metrics.2.delta'),
    value: 2840,
    valueSuffix: 'h',
    divisor: 1,
    foot: t('dataRoom.metrics.2.foot'),
    sparkPath: 'M0,32 L20,30 L40,26 L60,24 L80,20 L100,16 L120,14 L140,10 L160,8 L180,6 L200,4',
  },
  {
    key: '3',
    label: t('dataRoom.metrics.3.label'),
    delta: t('dataRoom.metrics.3.delta'),
    value: 14,
    valueSuffix: 'd',
    divisor: 1,
    foot: t('dataRoom.metrics.3.foot'),
    sparkPath: 'M0,4 L20,6 L40,8 L60,10 L80,12 L100,16 L120,18 L140,22 L160,24 L180,26 L200,28',
  },
  {
    key: '4',
    label: t('dataRoom.metrics.4.label'),
    delta: t('dataRoom.metrics.4.delta'),
    value: 47,
    valueSuffix: '',
    divisor: 1,
    foot: t('dataRoom.metrics.4.foot'),
    sparkPath: 'M0,4 L20,6 L40,8 L60,12 L80,14 L100,18 L120,20 L140,24 L160,26 L180,28 L200,30',
  },
  {
    key: '5',
    label: t('dataRoom.metrics.5.label'),
    delta: t('dataRoom.metrics.5.delta'),
    value: 9997,
    valueSuffix: '%',
    divisor: 100,
    foot: t('dataRoom.metrics.5.foot'),
    sparkPath: 'M0,8 L20,6 L40,6 L60,8 L80,4 L100,6 L120,4 L140,6 L160,4 L180,4 L200,4',
  },
  {
    key: '6',
    label: t('dataRoom.metrics.6.label'),
    delta: t('dataRoom.metrics.6.delta'),
    value: 74,
    valueSuffix: '',
    divisor: 1,
    foot: t('dataRoom.metrics.6.foot'),
    sparkPath: 'M0,28 L20,26 L40,22 L60,20 L80,16 L100,18 L120,12 L140,10 L160,8 L180,6 L200,4',
  },
];

// Log i18n
const logHead = t('dataRoom.log.head');
const logCols: [string, string, string, string] = [
  t('dataRoom.log.col0'),
  t('dataRoom.log.col1'),
  t('dataRoom.log.col2'),
  t('dataRoom.log.col3'),
];
---

<section
  id="phase-proof"
  class="phase"
  data-phase="3"
  role="region"
  aria-labelledby="data-heading"
>
  <div class="data-room-wrap">
    <!-- Section header -->
    <header class="data-room-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="data-heading" class="data-heading" set:html={h2} />
    </header>

    <!-- 3×2 metrics grid -->
    <div class="data-grid" role="list" aria-label="Key performance metrics">
      {metrics.map((m) => (
        <div role="listitem">
          <MetricCell
            label={m.label}
            delta={m.delta}
            value={m.value}
            valueSuffix={m.valueSuffix}
            divisor={m.divisor}
            foot={m.foot}
            cellId={`metric-cell-${m.key}`}
            sparkPath={m.sparkPath}
          />
        </div>
      ))}
    </div>

    <!-- Agent activity log -->
    <LogTable head={logHead} cols={logCols} />
  </div>
</section>

<script>
  /**
   * Phase 04 client-side behaviour:
   * data-active toggled by phase-orchestrator store when phase === 3.
   */
  import { subscribePhase } from '@/lib/scroll/phase-orchestrator';

  const section = document.getElementById('phase-proof');

  if (section) {
    subscribePhase(({ phase }) => {
      if (phase === 3) {
        section.dataset.active = 'true';
      } else {
        delete section.dataset.active;
      }
    });
  }
</script>

<style>
  /* ── Data Room wrapper ──────────────────────────────────────────────────── */

  .data-room-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    /* Container context — enables @container queries on child grids */
    container-type: inline-size;
  }

  /* ── Header ─────────────────────────────────────────────────────────────── */

  .data-room-header {
    text-align: center;
  }

  .data-heading {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    color: var(--color-fg);
  }

  :global(.data-heading em) {
    font-style: normal;
    color: var(--color-cyan);
    font-weight: 400;
  }

  /* ── 3×2 metrics grid ───────────────────────────────────────────────────── */

  .data-grid {
    display: grid;
    grid-template-columns: 1fr; /* base: 1-col (≤30rem) */
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  /* 2-col at ≥30rem (480px) within .data-room-wrap container */
  @container (min-width: 30rem) {
    .data-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* 3-col at ≥48rem (768px) within .data-room-wrap container */
  @container (min-width: 48rem) {
    .data-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .data-grid > [role="listitem"] {
    background: var(--color-bg);
  }

  /* ── Metric cell ────────────────────────────────────────────────────────── */

  :global(.cell) {
    position: relative;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 140px;
    overflow: hidden;
  }

  /* Corner decorations — 4px L-shaped hairlines in each corner */

  :global(.corner-tl),
  :global(.corner-tr),
  :global(.corner-bl),
  :global(.corner-br) {
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
  }

  :global(.corner-tl) {
    top: 0;
    left: 0;
    border-top: 1px solid var(--color-cyan);
    border-left: 1px solid var(--color-cyan);
    opacity: 0.5;
  }

  :global(.corner-tr) {
    top: 0;
    right: 0;
    border-top: 1px solid var(--color-cyan);
    border-right: 1px solid var(--color-cyan);
    opacity: 0.5;
  }

  :global(.corner-bl) {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid var(--color-cyan);
    border-left: 1px solid var(--color-cyan);
    opacity: 0.5;
  }

  :global(.corner-br) {
    bottom: 0;
    right: 0;
    border-bottom: 1px solid var(--color-cyan);
    border-right: 1px solid var(--color-cyan);
    opacity: 0.5;
  }

  /* ── Label row ──────────────────────────────────────────────────────────── */

  :global(.metric-label) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  :global(.metric-label-text) {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-dim);
  }

  /* ── Delta badge ────────────────────────────────────────────────────────── */

  :global(.delta) {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Positive delta — cyan */
  :global(.delta--positive) {
    color: var(--color-cyan);
    background: oklch(from var(--color-cyan) l c h / 0.12);
    border: 1px solid oklch(from var(--color-cyan) l c h / 0.3);
  }

  /* Negative delta — amber warn */
  :global(.delta--warn) {
    color: var(--color-warn);
    background: oklch(from var(--color-warn) l c h / 0.12);
    border: 1px solid oklch(from var(--color-warn) l c h / 0.3);
  }

  /* Neutral (plain numeric, e.g. "99.97%") */
  :global(.delta--neutral) {
    color: var(--color-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-line);
  }

  /* ── Sparkline SVG ──────────────────────────────────────────────────────── */

  :global(.spark) {
    width: 100%;
    height: 28px;
    flex-shrink: 0;
  }

  :global(.spark-fill) {
    fill: oklch(from var(--color-cyan) l c h / 0.06);
  }

  :global(.spark-line) {
    fill: none;
    stroke: var(--color-cyan);
    stroke-width: 1.5;
    opacity: 0.5;
    vector-effect: non-scaling-stroke;
  }

  /* ── Big number ─────────────────────────────────────────────────────────── */

  :global(.metric-num) {
    display: flex;
    align-items: baseline;
    gap: 0.125rem;
    line-height: 1;
  }

  :global(.metric-num .num) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 200;
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }

  :global(.metric-num .unit) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--color-cyan);
    font-weight: 400;
  }

  /* ── Metric foot ────────────────────────────────────────────────────────── */

  :global(.metric-foot) {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-dim);
    opacity: 0.7;
    margin-top: auto;
  }

  /* ── Log table ──────────────────────────────────────────────────────────── */

  :global(.log-table) {
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
  }

  :global(.log-title) {
    padding: 0.625rem 1rem;
    color: var(--color-cyan);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-line);
    background: oklch(from var(--color-cyan) l c h / 0.04);
  }

  :global(.log-row) {
    display: grid;
    grid-template-columns: 80px 160px 1fr 120px;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--color-line);
    align-items: center;
  }

  :global(.log-row:last-child) {
    border-bottom: none;
  }

  :global(.log-row--header) {
    color: var(--color-cyan);
    background: oklch(from var(--color-cyan) l c h / 0.04);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-line);
  }

  :global(.log-row:not(.log-row--header)) {
    color: var(--color-dim);
    transition: background var(--dur-fast) var(--ease-emphasized);
  }

  :global(.log-row:not(.log-row--header):hover) {
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.log-ts) {
    color: rgba(255, 255, 255, 0.3);
    font-variant-numeric: tabular-nums;
  }

  :global(.log-id) {
    color: var(--color-cyan);
    opacity: 0.8;
  }

  :global(.log-op) {
    color: var(--color-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.log-res) {
    text-align: right;
    color: var(--color-fg);
    opacity: 0.7;
  }

  :global(.log-cell--right) {
    text-align: right;
  }

  /* ── Responsive: log table on small screens ─────────────────────────────── */
  /* data-grid columns are now handled via @container above.
   * Log table still uses media query as it has no dedicated container. */

  @media (max-width: 640px) {
    :global(.log-row) {
      grid-template-columns: 70px 1fr 80px;
    }

    /* Hide Operation column on very small screens */
    :global(.log-op),
    :global(.log-row--header span:nth-child(3)) {
      display: none;
    }
  }
</style>
