---
/**
 * PhaseEcosystem.astro — Phase 03 / Ecossistema (Ecosystem)
 *
 * Displays the ecosystem phase with eyebrow, h2, sub-paragraph, and a 2-column
 * grid of EcoCard components (Gabriel / Darkflow).
 *
 * Migrated from v0 VHXCO.html:1711-1742 with expanded copy (~200 words).
 * v0 used absolute positioning — replaced with CSS Grid (2 columns).
 *
 * Bug fix: ecoEy was reused in 3 places (eyebrow, nav, rail). v1 splits:
 *   - ecosystem.eyebrow → "Capítulo 03 / Ecossistema" (only for the eyebrow)
 *   - ecosystem.chapterLabel → "Ecossistema" (for nav + rail)
 *
 * i18n strategy:
 *   - eyebrow: from src/i18n/ui.ts (useTranslations — flat dict)
 *   - h2 + sub + card content: from src/lib/i18n/locales/*.json (getT)
 *
 * Stack badges are hard-coded per product (not translated):
 *   Gabriel   → REACT NATIVE, EXPO, SUPABASE, REVENUECAT, GEMINI
 *   Darkflow  → PYTHON, AI AGENTS, AUTOMATION, DOCKER
 *
 * Phase orchestrator:
 *   - data-phase="2" observed by createPhaseOrchestrator (reduced-motion mode)
 *   - data-active toggled by subscribePhase() listener in script
 */

import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';
import EcoCard from './EcoCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tLocale = getT(lang as Locale);

// Flat dict (ui.ts) — eyebrow
const eyebrow = t('ecosystem.eyebrow');

// JSON locale — h2 + sub
const h2  = tLocale('ecosystem.h2');
const sub = tLocale('ecosystem.sub');

const subParagraphs = sub.split('\n').filter((p) => p.trim().length > 0);

// Gabriel card
const gabrielName      = tLocale('ecosystem.cards.gabriel.title');
const gabrielTypeBadge = tLocale('ecosystem.cards.gabriel.typeBadge');
const gabrielDesc      = tLocale('ecosystem.cards.gabriel.desc');

// Darkflow card
const darkflowName      = tLocale('ecosystem.cards.darkflow.title');
const darkflowTypeBadge = tLocale('ecosystem.cards.darkflow.typeBadge');
const darkflowDesc      = tLocale('ecosystem.cards.darkflow.desc');
---

<section
  id="phase-ecosystem"
  class="phase phase-ecosystem"
  data-phase="2"
  role="region"
  aria-labelledby="eco-heading"
>
  <div class="eco-content phase-scrim">
    <div class="eco-header extractable" data-extractable-index="0" style="--extract-index: 0;">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="eco-heading" class="headline eco-headline" set:html={h2} />
      <div class="eco-sub">
        {subParagraphs.map((para) => <p>{para}</p>)}
      </div>
    </div>

    <div class="eco-grid">
      <EcoCard
        name={gabrielName}
        typeBadge={gabrielTypeBadge}
        desc={gabrielDesc}
        stack={["REACT NATIVE", "EXPO", "SUPABASE", "REVENUECAT", "GEMINI"]}
        index={1}
      />
      <EcoCard
        name={darkflowName}
        typeBadge={darkflowTypeBadge}
        desc={darkflowDesc}
        stack={["PYTHON", "AI AGENTS", "AUTOMATION", "DOCKER"]}
        index={2}
      />
    </div>
  </div>
</section>

<style>
  /*
   * .eco-content — F3-specific scrim strengthening (QA-night-iter02)
   *
   * The Phase 03 canvas has a bright red synapse directly behind the text
   * block. Default .phase-scrim vars (0.45 → 0.15) are insufficient — text
   * competes with the red glow. Override to values slightly stronger than
   * F1 (.core-scrim uses 0.62 → 0.40) to compensate for the red channel.
   *
   * Technique mirrors .core-scrim exactly:
   *   - Override --scrim-top/--scrim-bottom vars
   *   - background: transparent + position: relative so only ::before renders
   *   - ::before pseudo with radial vignette mask (edges fade → mesh breathes)
   *   - text-shadow on eyebrow + headline + sub paragraphs for local contrast
   *
   * IMPORTANT: does NOT touch global.css defaults — F2 (cards) is unaffected.
   */
  .eco-content {
    /* ── F3-specific scrim vars ──────────────────────────────────────────────
     * Slightly stronger than F1 (0.62/0.40) to fight the red synapse.
     * Still clearly translucent — neural mesh remains visible behind text.
     * ─────────────────────────────────────────────────────────────────────── */
    --scrim-top: rgba(0, 0, 0, 0.68);
    --scrim-bottom: rgba(0, 0, 0, 0.45);

    /* Stacking context for ::before vignette pseudo-element */
    position: relative;

    /* Suppress the .phase-scrim flat gradient — the ::before vignette with
     * the radial mask renders the gradient instead, so edges fade naturally
     * into the 3D space rather than a hard rectangular slab. */
    background: transparent;
  }

  /* ── Soft-edge vignette via ::before ────────────────────────────────────────
   * Same pattern as .core-scrim::before: renders the dark gradient on a
   * pseudo-element so mask-image never clips text or text-shadow halos.
   * Radial mask → full opacity at center (text), transparent at outer edges
   * → neural mesh and red synapse "breathe" around the content area.
   * ─────────────────────────────────────────────────────────────────────────── */
  .eco-content::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to bottom,
      var(--scrim-top),
      var(--scrim-bottom)
    );
    -webkit-mask-image: radial-gradient(ellipse 110% 100% at 50% 50%, black 55%, transparent 100%);
            mask-image: radial-gradient(ellipse 110% 100% at 50% 50%, black 55%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Text-shadow — local contrast against the red synapse ───────────────────
   * Dark halo adds legibility per-element without requiring an even heavier
   * scrim opacity. Scoped to F3 only — does not affect F1/F2/F4/F5.
   * ─────────────────────────────────────────────────────────────────────────── */
  .eco-content :global(.eyebrow),
  .eco-content :global(h2.eco-headline),
  .eco-content :global(.eco-sub p) {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
    position: relative;
    z-index: 1;
  }
</style>

<script>
  /**
   * Phase 03 client-side behaviour:
   *
   * data-active: subscribe to journey activeStop. Toggle data-active
   * on the section when activeStop === 2. CSS transitions + extractIn animations
   * are gated on [data-active] presence.
   */
  import { subscribeActiveStop, getActiveStop } from '@/lib/journey/journey-state';

  const section = document.getElementById('phase-ecosystem');

  if (section) {
    subscribeActiveStop(() => {
      if (getActiveStop() === 2) {
        section.dataset.active = 'true';
      } else {
        delete section.dataset.active;
      }
    });
  }
</script>
