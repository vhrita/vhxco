---
/**
 * PhaseDiagnose.astro — Phase 05 / Diagnose
 *
 * Terminal-styled contact phase with 2-column grid:
 *   Left  — eyebrow + h2 + description + meta (duration / format / investment / next-slot)
 *   Right — DiagnoseForm React island (client:visible — lazy-loads on scroll)
 *
 * i18n: all copy from src/lib/i18n/locales/*.json via getT helper.
 * Formspree ID: injected from PUBLIC_FORMSPREE_ID env var (never committed).
 *
 * Migrated from v0 VHXCO.html:1756-1804 with i18n fixes.
 *
 * data-phase="4": phase-orchestrator uses this for scroll sync.
 */

import { getLangFromUrl } from '@/i18n/utils';
import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';
import DiagnoseForm from '@/components/forms/DiagnoseForm';

const lang = getLangFromUrl(Astro.url);
const tLocale = getT(lang as Locale);

// Pull all copy from JSON dict
const eyebrow         = tLocale('diagnose.eyebrow');
const headline        = tLocale('diagnose.headline');
const description     = tLocale('diagnose.description');

const durationLabel   = tLocale('diagnose.meta.durationLabel');
const durationValue   = tLocale('diagnose.meta.durationValue');
const formatLabel     = tLocale('diagnose.meta.formatLabel');
const formatValue     = tLocale('diagnose.meta.formatValue');
const investmentLabel = tLocale('diagnose.meta.investmentLabel');
const investmentValue = tLocale('diagnose.meta.investmentValue');
const nextSlotLabel   = tLocale('diagnose.meta.nextSlotLabel');

// Form labels — passed as prop to React island (avoids i18n import in client bundle)
const formLabels = {
  formTitle:         tLocale('diagnose.form.title'),
  formLive:          tLocale('diagnose.form.live'),
  namePrompt:        tLocale('diagnose.form.namePrompt'),
  namePlaceholder:   tLocale('diagnose.form.namePlaceholder'),
  emailPrompt:       tLocale('diagnose.form.emailPrompt'),
  emailPlaceholder:  tLocale('diagnose.form.emailPlaceholder'),
  companyPrompt:     tLocale('diagnose.form.companyPrompt'),
  companyPlaceholder:tLocale('diagnose.form.companyPlaceholder'),
  bottleneckPrompt:  tLocale('diagnose.form.bottleneckPrompt'),
  briefPrompt:       tLocale('diagnose.form.briefPrompt'),
  briefPlaceholder:  tLocale('diagnose.form.briefPlaceholder'),
  bn1:               tLocale('diagnose.form.bn1'),
  bn2:               tLocale('diagnose.form.bn2'),
  bn3:               tLocale('diagnose.form.bn3'),
  bn4:               tLocale('diagnose.form.bn4'),
  submit:            tLocale('diagnose.form.submit'),
  sending:           tLocale('diagnose.form.sending'),
  ok:                tLocale('diagnose.form.ok'),
  networkFailure:    tLocale('errors.form.networkFailure'),
  configMissing:     tLocale('diagnose.form.configMissing'),
  // iter-08 Fix D2: fallback CTA when Formspree not configured
  fallbackTag:       tLocale('diagnose.form.fallbackTag'),
  fallbackCopy:      tLocale('diagnose.form.fallbackCopy'),
  fallbackCta:       tLocale('diagnose.form.fallbackCta'),
};

// Formspree ID: set in .env.local by Vitor (never committed).
// Falls back to undefined → DiagnoseForm shows configMissing message.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
---

<section
  id="phase-diagnose"
  class="phase phase-diagnose"
  data-phase="4"
  role="region"
  aria-labelledby="dg-heading"
>
  <div class="diagnose-grid">
    <!-- LEFT: meta + description -->
    <div class="diagnose-left">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="dg-heading" class="diagnose-headline" set:html={headline} />
      <p class="diagnose-desc">{description}</p>

      <dl class="diagnose-meta">
        <div class="meta-row">
          <dt class="meta-key">{durationLabel}</dt>
          <dd class="meta-val">{durationValue}</dd>
        </div>
        <div class="meta-row">
          <dt class="meta-key">{formatLabel}</dt>
          <dd class="meta-val">{formatValue}</dd>
        </div>
        <div class="meta-row">
          <dt class="meta-key">{investmentLabel}</dt>
          <dd class="meta-val meta-val--highlight">{investmentValue}</dd>
        </div>
        <div class="meta-row">
          <dt class="meta-key">{nextSlotLabel}</dt>
          <!-- Next-slot value is rendered by DiagnoseForm via Intl.DateTimeFormat -->
          <dd class="meta-val" id="nextSlotDisplay">—</dd>
        </div>
      </dl>
    </div>

    <!-- RIGHT: terminal form (React island) -->
    <div class="diagnose-right">
      <DiagnoseForm
        client:visible
        locale={lang as Locale}
        formspreeId={formspreeId}
        labels={formLabels}
      />
    </div>
  </div>
</section>

<script>
  import { subscribeActiveStop, getActiveStop } from '@/lib/journey/journey-state';

  const section = document.getElementById('phase-diagnose');

  if (section) {
    subscribeActiveStop(() => {
      if (getActiveStop() === 4) {
        section.dataset.active = 'true';
      } else {
        delete section.dataset.active;
      }
    });
  }
</script>

<style>
  /* ── Phase Diagnose layout ───────────────────────────────────────────────── */

  /*
   * QA iter-01 Batch B: removidos overrides de `align-items / justify-content
   * / padding` que sobrescreviam `.phase`. O padding fixed-zone agora vem
   * exclusivamente de `.phase` global. `.phase-diagnose` mantém só o hook.
   */
  .phase-diagnose {
    /* intentionally empty */
  }

  /*
   * Grid base: 1-col. 2-col só em container ≥ 90rem (1440px).
   * Decisão de design QA iter-01 Batch B (P1-7): em 1024/1280, a coluna
   * direita ficava esmagada e o painel terminal "FORM NÃO CONFIGURADO" só
   * preenchia ~1/4 da altura. Agora abaixo de 1440px o grid colapsa pra
   * single column — terminal panel cresce naturalmente. Em 1440+ o 2-col
   * volta com `align-self: stretch` no `.diagnose-right` pra terminal ocupar
   * altura total do row.
   */
  .diagnose-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-width: 1100px;
    width: 100%;
    align-items: start;
    /* Container context — enables @container queries on child elements */
    container-type: inline-size;
  }

  /* 2-col at ≥ 90rem (1440px) viewport. Usamos `@media` aqui (não @container)
   * porque o `.phase-diagnose` não tem `container-type` próprio — ele herda
   * de `.phase` (fixed, full-viewport), então media query e container query
   * dariam o mesmo resultado. @media é mais simples e óbvio neste caso. */
  @media (min-width: 90rem) {
    .diagnose-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .diagnose-right {
      align-self: stretch;
    }
  }

  /* ── Left column ─────────────────────────────────────────────────────────── */

  .diagnose-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    /* Glass card effect (Fix-set E — Phases 02-05 only, not Phase 01) */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.15));
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2rem;
  }

  /* Eyebrow — shared global class, left-aligned override */
  .diagnose-left .eyebrow {
    justify-content: flex-start;
  }

  .diagnose-left .eyebrow::before {
    display: none;
  }

  .diagnose-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0;
    color: var(--color-fg);
  }

  .diagnose-headline em {
    font-style: normal;
    color: var(--color-cyan);
    font-weight: 400;
  }

  .diagnose-desc {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    color: rgba(255, 255, 255, 0.55);
    line-height: var(--leading-normal);
    margin: 0;
    max-width: 400px;
  }

  /* ── Meta table ──────────────────────────────────────────────────────────── */

  .diagnose-meta {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  .meta-key {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-dim);
    flex: 0 0 110px;
  }

  .meta-val {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-fg);
    margin: 0;
  }

  .meta-val--highlight {
    color: var(--color-cyan);
    font-weight: 600;
  }

  /* ── Right column — terminal container ──────────────────────────────────── */

  .diagnose-right {
    display: flex;
    flex-direction: column;
  }

  /* ── Terminal form styles (React island renders into .terminal) ─────────── */
  /* These are :global because they target classes inside the React component */

  .diagnose-right :global(.terminal) {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    overflow: hidden;
  }

  .diagnose-right :global(.terminal-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.875rem;
    background: rgba(94, 234, 255, 0.06);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .diagnose-right :global(.terminal-live) {
    color: var(--color-cyan);
    animation: pulseDot 2s infinite;
  }

  .diagnose-right :global(.term-body) {
    padding: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .diagnose-right :global(.term-line) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.5rem;
  }

  .diagnose-right :global(.term-line--stack) {
    flex-direction: column;
    align-items: flex-start;
  }

  .diagnose-right :global(.term-prompt) {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cyan);
    flex-shrink: 0;
    min-width: 90px;
    opacity: 0.8;
  }

  .diagnose-right :global(.term-prompt--dim) {
    color: var(--color-dim);
  }

  .diagnose-right :global(.term-input),
  .diagnose-right :global(.term-area) {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-normal);
    flex: 1;
    width: 100%;
    caret-color: var(--color-cyan);
    transition: color 150ms ease;
  }

  .diagnose-right :global(.term-input::placeholder),
  .diagnose-right :global(.term-area::placeholder) {
    color: rgba(255, 255, 255, 0.2);
  }

  .diagnose-right :global(.term-input:focus),
  .diagnose-right :global(.term-area:focus) {
    color: var(--color-cyan);
  }

  .diagnose-right :global(.term-area) {
    resize: none;
    line-height: 1.6;
    margin-top: 0.25rem;
  }

  /* Bottleneck options */
  .diagnose-right :global(.term-options) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .diagnose-right :global(.term-option-btn) {
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-dim);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background 150ms ease;
  }

  .diagnose-right :global(.term-option-btn:hover) {
    color: var(--color-fg);
    border-color: var(--color-fg);
  }

  .diagnose-right :global(.term-option-btn.active) {
    color: var(--color-bg);
    background: var(--color-cyan);
    border-color: var(--color-cyan);
  }

  .diagnose-right :global(.term-option-btn:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Next-slot row */
  .diagnose-right :global(.term-next-slot) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-dim);
    padding-top: 0.25rem;
  }

  .diagnose-right :global(.term-slot-value) {
    color: var(--color-fg);
    opacity: 0.7;
  }

  /* Submit button */
  .diagnose-right :global(.term-submit) {
    margin-top: 0.625rem;
    width: 100%;
    background: var(--color-cyan);
    border: none;
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    padding: 0.625rem 1rem;
    cursor: pointer;
    transition: opacity 200ms ease;
    font-weight: 600;
  }

  .diagnose-right :global(.term-submit:hover) {
    opacity: 0.88;
  }

  .diagnose-right :global(.term-submit:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Messages */
  .diagnose-right :global(.term-success-msg) {
    color: var(--color-cyan);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 1rem 0;
    margin: 0;
    text-align: center;
  }

  .diagnose-right :global(.term-error-msg) {
    color: var(--color-warn);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0;
    padding-top: 0.25rem;
  }

  .diagnose-right :global(.term-config-error) {
    color: var(--color-dim);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0;
    padding: 0.5rem 0;
  }

  /* iter-08 Fix D2: fallback state — terminal awaiting Formspree config */

  /* Suppress pulseDot animation on the tag (semantically wrong for "AWAITING").
   * Keeps cyan color + typography from .terminal-live. */
  .diagnose-right :global(.term-fallback-tag) {
    animation: none;
    opacity: 0.7;
  }

  .diagnose-right :global(.term-fallback-copy) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: rgba(255, 255, 255, 0.6);
    line-height: var(--leading-relaxed);
    margin: 0 0 1rem;
    padding: 0.5rem 0;
  }

  /* Inherits visual of .term-submit (cyan bg + uppercase mono) + link affordances */
  .diagnose-right :global(.term-fallback-cta) {
    text-decoration: none;
    display: block;
    text-align: center;
    margin-top: 0;
  }

  /* ── Height compression — F5 Diagnose CTA visible in short viewports ────────
   *
   * qa-night-iter05: `.phase { overflow: hidden }` means ALL content must fit
   * within the viewport height. Two breakpoints:
   *   max-height: 916px — covers iPhones 812-896 + 1024×768; skips 768×1024
   *   max-height: 700px — targets 375×667 (h=667≤700); extra-aggressive compression
   *
   * qa-night-iter08: threshold raised 800→916 to cover iPhone 13/14/15/XR/11
   * (812–896px tall). 932 Pro Max fits naturally without tier1. At wide
   * viewports (≥ 1024px) the headline is kept softer (2.5rem) so the 2-col
   * layout at 1440×900 doesn't look undersized; the hard 2rem cap is reserved
   * for narrow mobile (< 768px) where the column is ~390px wide.
   *
   * Approach: compress gaps/paddings/headline on the left column + tighten
   * terminal body so the fallback CTA (last child) stays in the visible zone.
   * Never touch: h2 visibility, scroll on .phase, other phases.
   */

  /* ── Tier 1: max-height 916px — covers iPhones 812–896 + 1024×768 ─────────
   * Bifurcated headline cap: narrow (< 768px) → 2rem, wider → 2.5rem.
   * This prevents the headline from shrinking too aggressively in 1440×900
   * 2-col layout where the left column is wide enough to hold larger text.
   */
  @media (max-height: 916px) {
    /* Phase padding: tighten vertical so the phase container gives back height */
    .phase-diagnose {
      padding-block: 0.75rem;
    }

    /* Grid: reduce inter-column (1-col layout) gap */
    .diagnose-grid {
      gap: 1rem;
    }

    /* Left card: tighter padding + smaller internal gap */
    .diagnose-left {
      padding: 1rem;
      gap: 0.75rem;
    }

    /* Headline: softer cap for wider viewports (1440×900 2-col); harder cap
     * for narrow mobile (<768px) where clamp resolves smaller anyway */
    .diagnose-headline {
      font-size: 2.5rem;
    }

    /* Meta table: tighter rows */
    .diagnose-meta {
      gap: 0.375rem;
    }

    .meta-row {
      padding-bottom: 0.25rem;
    }

    /* Terminal body: tighter padding + gap */
    .diagnose-right :global(.term-body) {
      padding: 0.5rem 0.625rem;
      gap: 0.375rem;
    }

    /* Fallback copy: tighter margin so CTA is closer */
    .diagnose-right :global(.term-fallback-copy) {
      margin-bottom: 0.375rem;
      padding: 0.25rem 0;
    }
  }

  /* Narrow mobile (<768px wide) within tier1: tighter headline cap since
   * column is only ~350-430px wide — 2.5rem is fine, 2rem is also fine. */
  @media (max-height: 916px) and (max-width: 767px) {
    .diagnose-headline {
      font-size: 2rem;
    }
  }

  /* ── Tier 2: max-height 700px — covers 375×667 (extreme case) ───────────── */
  @media (max-height: 700px) {
    /* Phase padding: minimal so every px counts */
    .phase-diagnose {
      padding-block: 0.5rem;
    }

    /* Left card: absolute minimum padding */
    .diagnose-left {
      padding: 0.75rem;
      gap: 0.5rem;
    }

    /* Headline: tight at narrow height */
    .diagnose-headline {
      font-size: 1.75rem;
      line-height: 1.15;
    }

    /* Description: reduce line-height to save vertical space */
    .diagnose-desc {
      line-height: 1.4;
    }

    /* Meta: collapse gaps nearly to zero — still readable, just denser */
    .diagnose-meta {
      gap: 0.25rem;
    }

    .meta-row {
      padding-bottom: 0.125rem;
    }

    /* Terminal: tightest layout */
    .diagnose-right :global(.term-body) {
      padding: 0.375rem 0.5rem;
      gap: 0.25rem;
    }

    /* Fallback copy: no margin, tightest leading */
    .diagnose-right :global(.term-fallback-copy) {
      margin-bottom: 0.25rem;
      padding: 0;
      line-height: 1.4;
    }
  }
</style>
