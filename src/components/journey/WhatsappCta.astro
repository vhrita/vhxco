---
/**
 * WhatsappCta.astro — Persistent floating WhatsApp CTA (BR-first conversion #1).
 *
 * A always-visible floating action button that opens a WhatsApp chat with a
 * pre-filled message. Mirrors PersistentCta.astro's treatment (fixed, z-25,
 * cyan-on-dark, boot-hide gated) but sits in the OPPOSITE bottom corner
 * (bottom-LEFT) so it never collides with:
 *   - #persistent-cta  ("Diagnosticar", bottom-RIGHT, z-25)
 *   - #scroll-indicator (base-center, z-24, pointer-events:none)
 *   - .topnav / mobile sidebar drawer (top, z-30)
 *
 * On-brand, NOT WhatsApp green: the glyph is recognizable but rendered in the
 * site's cyan on a dark glass disc + cyan ring + soft cyan glow, so it reads as
 * "WhatsApp" by the icon without breaking the premium dark/cyan aesthetic.
 *
 * Persistence: unlike PersistentCta (which hides on the last/action stop), this
 * stays visible on EVERY stop — the WhatsApp channel is always relevant. It only
 * hides during boot/genesis + the cinematic dolly (same gates as the other UI),
 * revealing with the rest of the chrome on journey:intro-done. Visibility gates
 * live in global.css (they cross the body→#whatsapp-cta scope boundary, same
 * constraint as PersistentCta/ScrollIndicator).
 *
 * Analytics: fires the gated `whatsapp_click` PostHog event on click (no-op when
 * PUBLIC_POSTHOG_KEY is absent) — follows the funnel-event pattern (metadata
 * only, never field values). See src/lib/analytics/posthog.ts.
 *
 * Locale: message text + aria-label switch on the locale prop.
 */

interface Props {
  locale?: 'pt' | 'en';
}

const { locale = 'pt' } = Astro.props;

// Sales line, BR-first. Same number as the JSON-LD ContactPoint (+5519981952548).
const WA_NUMBER = '5519981952548';

const message =
  locale === 'en'
    ? 'Hi! I came from the VHXCO site and want to talk about a diagnostic.'
    : 'Olá! Vim pelo site da VHXCO e quero conversar sobre um diagnóstico.';

// wa.me expects the prefilled body url-encoded in the `text` query param.
const href = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(message)}`;

const label =
  locale === 'en' ? 'Chat with us on WhatsApp' : 'Conversar no WhatsApp';
---

<a
  class="whatsapp-cta"
  id="whatsapp-cta"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
  title={label}
>
  {/* Official WhatsApp glyph, currentColor so it inherits the on-brand cyan. */}
  <svg
    class="whatsapp-cta-glyph"
    viewBox="0 0 24 24"
    width="26"
    height="26"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.546 4.142 1.588 5.945L0 24l6.335-1.652a11.882 11.882 0 005.71 1.447h.006c6.585 0 11.946-5.36 11.949-11.893a11.821 11.821 0 00-3.481-8.413z"
    ></path>
  </svg>
</a>

<script>
  // Analytics: fire the gated `whatsapp_click` funnel event on click. No-op when
  // PostHog is disabled (no key). target="_blank" keeps this tab, so the capture
  // runs before the new tab opens. Metadata only (source) — never field values.
  import { capture } from '@/lib/analytics/posthog';

  const link = document.getElementById('whatsapp-cta');
  if (link) {
    link.addEventListener('click', () => {
      capture('whatsapp_click', { source: 'floating_cta' });
    });
  }
</script>

<style>
  .whatsapp-cta {
    position: fixed;
    /* Bottom-LEFT — mirror of #persistent-cta (bottom-right) so the two float
     * on opposite corners and never overlap. Same baseline as the Diagnosticar
     * pill (bottom: 1.75rem) for a balanced pair. */
    bottom: 1.75rem;
    left: 1.5rem;
    /* z-index 25: matches #persistent-cta — above content (10), below chrome
     * overlays (30+). */
    z-index: 25;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem; /* 48px — comfortable tap target (WCAG ≥44px) */
    height: 3rem;

    color: var(--color-cyan);
    /* On-brand: dark glass disc + cyan ring + soft cyan glow. Recognizable as
     * WhatsApp by the glyph, not the loud brand green. The gentle persistent
     * glow lifts it off the dark 3D so it stays VISIBLE without shouting. */
    background: rgba(0, 0, 0, 0.62);
    border: 1px solid var(--color-cyan);
    border-radius: 50%;
    box-shadow: 0 0 14px oklch(from var(--color-cyan) l c h / 0.28);

    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 200ms,
      box-shadow 200ms,
      transform 200ms,
      opacity 200ms;
    outline-offset: 4px;
  }

  .whatsapp-cta:hover {
    background: oklch(from var(--color-cyan) l c h / 0.14);
    box-shadow: 0 0 20px oklch(from var(--color-cyan) l c h / 0.45);
    transform: translateY(-1px);
  }

  .whatsapp-cta:focus-visible {
    outline: 2px solid var(--color-cyan);
  }

  .whatsapp-cta-glyph {
    display: block;
    /* Optical centering — the glyph's speech-bubble tail weights it slightly
     * down/left; nudge it back to the disc's visual center. */
    transform: translate(0.5px, -0.5px);
  }

  /* Large-screen pass: grow the FAB so it isn't a tiny stamp on 1440/1920,
   * mirroring #persistent-cta's large-screen lift. */
  @media (min-width: 1440px) {
    .whatsapp-cta {
      bottom: 2.25rem;
      left: 2rem;
      width: 3.5rem; /* 56px */
      height: 3.5rem;
    }
    .whatsapp-cta-glyph {
      width: 30px;
      height: 30px;
    }
  }

  @media (min-width: 1920px) {
    .whatsapp-cta {
      bottom: 2.75rem;
      left: 2.5rem;
      width: 3.75rem; /* 60px */
      height: 3.75rem;
    }
    .whatsapp-cta-glyph {
      width: 32px;
      height: 32px;
    }
  }

  /* Reduced-motion: no lift/scale nudges on hover (the glow still confirms
   * interactivity). Global §9 already collapses transition durations. */
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-cta:hover {
      transform: none;
    }
  }
</style>
