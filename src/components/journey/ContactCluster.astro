---
/**
 * ContactCluster.astro — Sibling "terminal" contact panel for the Diagnose stop.
 *
 * v2 REWRITE (Vitor feedback): the previous version stacked ALL channels in a
 * single block BELOW the DiagnoseForm on the action stop. On a fixed-height stop
 * that overflowed — panels tucked under the navbar / glued to the viewport edges,
 * even on desktop. This is now a self-contained panel that lives BESIDE the form:
 *   - Desktop (≥1024px): a second column next to DIAGNOSE.SH (2-col deck).
 *   - Mobile  (<1024px): the second slide of a horizontal scroll-snap slider.
 * The deck wrapper + slider chrome + responsive layout live in JourneyStop.astro;
 * this file only renders the panel body. It is rendered into the `contact` slot.
 *
 * Visual: matches the form's `.terminal` panel exactly (same glass, cyan accent,
 * mono) so the two read as sibling terminals — header `VHXCO // CONTATO.SH`.
 * On-brand channel glyphs rendered in the site cyan (NOT WhatsApp green / IG
 * gradient / LinkedIn blue). Tokens only — no literal color values.
 *
 * Each channel shows the info as VISIBLE TEXT plus an action control:
 *   - WhatsApp (primary, emphasized): full-width cyan-outline button → wa.me deep
 *     link with a pre-filled sales line (BR-first; PT/EN differ only in the text).
 *   - Phone: shows +55 19 98195-2548. Button is ADAPTIVE (wired in JS):
 *       · touch / coarse pointer  → `tel:` link (opens the dialer), action "tel".
 *       · desktop / fine pointer  → COPY to clipboard, action "copy" + "Copiado!".
 *     No-JS fallback = the `tel:` link (harmless on desktop; the number is also
 *     visible as text to copy by hand).
 *   - E-mail: shows hello@vhxco.com. Button COPIES to clipboard (NOT mailto —
 *     most desktop users are on webmail, mailto opens nothing useful).
 *   - Instagram / LinkedIn: open the profile in a new tab (rel=noopener
 *     noreferrer) with the handle/label visible.
 *
 * a11y: every control has a descriptive aria-label; tap targets ≥44px; a single
 * aria-live region announces "Copiado!" after a copy. Copy feedback also flips
 * the pressed button's label for ~1.6s.
 *
 * Analytics: fires the gated `contact_click` PostHog event with
 * { channel, action: 'open' | 'copy' | 'tel', source: 'diagnose' } on click
 * (no-op when PUBLIC_POSTHOG_KEY is absent). Metadata only — never field values.
 * See src/lib/analytics/posthog.ts.
 */

import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';

interface Props {
  locale?: 'pt' | 'en';
}

const { locale = 'pt' } = Astro.props;
const t = getT(locale as Locale);

// Raw, non-localized contact values (single source of truth for links + data-*).
const PHONE = '+5519981952548'; // tel: / clipboard target (E.164, no spaces)
const EMAIL = 'hello@vhxco.com';
const IG_URL = 'https://www.instagram.com/vhxcompany/';
const LI_URL = 'https://www.linkedin.com/company/vhxcompany/';

// WhatsApp: pre-encoded sales line, BR-first. Same number as the JSON-LD
// ContactPoint (+5519981952548). PT/EN differ only in the prefilled `text`.
const waHref =
  locale === 'en'
    ? 'https://wa.me/5519981952548?text=Hi!%20I%20came%20from%20the%20VHXCO%20site%20and%20want%20to%20talk%20about%20a%20diagnosis.'
    : 'https://wa.me/5519981952548?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20VHXCO%20e%20quero%20conversar%20sobre%20um%20diagn%C3%B3stico.';
---

<section
  class="terminal contact-terminal"
  aria-label={t('contact.panelTitle')}
  data-copied-label={t('contact.copied')}
>
  <div class="terminal-head">
    <span>{t('contact.panelTitle')}</span>
    <span class="terminal-live contact-live">{t('contact.panelLive')}</span>
  </div>

  <div class="term-body contact-body">
    <p class="contact-intro">{t('contact.intro')}</p>

    {/* Primary — WhatsApp, emphasized (BR-first). Full-width cyan-outline button;
        distinct from the solid-cyan form submit so the two never duplicate. */}
    <a
      class="contact-cta"
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('contact.whatsappAria')}
      data-channel="whatsapp"
      data-action="open"
    >
      <svg
        class="contact-cta-glyph"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.546 4.142 1.588 5.945L0 24l6.335-1.652a11.882 11.882 0 005.71 1.447h.006c6.585 0 11.946-5.36 11.949-11.893a11.821 11.821 0 00-3.481-8.413z"
        ></path>
      </svg>
      <span>{t('contact.whatsapp')}</span>
    </a>

    {/* Secondary — each channel: glyph + label + visible value + action button */}
    <ul class="contact-rows" role="list">
      {/* Phone — adaptive (tel on touch, copy on desktop) */}
      <li class="contact-row">
        <span class="contact-row-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <span class="contact-row-text">
          <span class="contact-row-label">{t('contact.phoneLabel')}</span>
          <span class="contact-row-value">{t('contact.phoneValue')}</span>
        </span>
        <a
          class="contact-row-btn"
          href={`tel:${PHONE}`}
          data-channel="phone"
          data-action="tel"
          data-copy={PHONE}
          data-adaptive-phone
          data-label-call={t('contact.phoneCall')}
          data-label-copy={t('contact.phoneCopy')}
          data-aria-call={t('contact.phoneAria')}
          data-aria-copy={t('contact.phoneCopyAria')}
          aria-label={t('contact.phoneAria')}
        >
          <span class="contact-row-btn-label">{t('contact.phoneCall')}</span>
        </a>
      </li>

      {/* E-mail — copy (never mailto) */}
      <li class="contact-row">
        <span class="contact-row-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <span class="contact-row-text">
          <span class="contact-row-label">{t('contact.emailLabel')}</span>
          <span class="contact-row-value">{t('contact.emailValue')}</span>
        </span>
        <button
          type="button"
          class="contact-row-btn"
          data-channel="email"
          data-action="copy"
          data-copy={EMAIL}
          data-label-copy={t('contact.emailCopy')}
          aria-label={t('contact.emailAria')}
        >
          <span class="contact-row-btn-label">{t('contact.emailCopy')}</span>
        </button>
      </li>

      {/* Instagram — open profile in a new tab */}
      <li class="contact-row">
        <span class="contact-row-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" focusable="false">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
          </svg>
        </span>
        <span class="contact-row-text">
          <span class="contact-row-label">{t('contact.instagramLabel')}</span>
          <span class="contact-row-value">{t('contact.instagramValue')}</span>
        </span>
        <a
          class="contact-row-btn"
          href={IG_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-channel="instagram"
          data-action="open"
          aria-label={t('contact.instagramAria')}
        >
          <span class="contact-row-btn-label">{t('contact.instagramOpen')}</span>
        </a>
      </li>

      {/* LinkedIn — open company page in a new tab */}
      <li class="contact-row">
        <span class="contact-row-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" focusable="false">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
          </svg>
        </span>
        <span class="contact-row-text">
          <span class="contact-row-label">{t('contact.linkedinLabel')}</span>
          <span class="contact-row-value">{t('contact.linkedinValue')}</span>
        </span>
        <a
          class="contact-row-btn"
          href={LI_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-channel="linkedin"
          data-action="open"
          aria-label={t('contact.linkedinAria')}
        >
          <span class="contact-row-btn-label">{t('contact.linkedinOpen')}</span>
        </a>
      </li>
    </ul>

    {/* Copy-feedback announcer (visually hidden) — polite so it never interrupts */}
    <span class="contact-sr-status" role="status" aria-live="polite" data-copy-status></span>
  </div>
</section>

<script>
  // ── Contact panel behavior ────────────────────────────────────────────────
  // 1) Adaptive phone: on a coarse (touch) pointer keep the `tel:` link; on a
  //    fine (desktop) pointer swap it to a copy-to-clipboard button.
  // 2) E-mail: always copy (never mailto).
  // 3) Analytics: gated `contact_click` { channel, action, source:'diagnose' }.
  // No-op-safe: capture() is a no-op when PostHog has no key.
  import { capture } from '@/lib/analytics/posthog';

  const panel = document.querySelector<HTMLElement>('.contact-terminal');
  if (panel) {
    const COPIED = panel.getAttribute('data-copied-label') ?? 'Copiado!';
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');

    // Coarse pointer = touch device (no hover, big finger) → keep the dialer.
    const coarse =
      window.matchMedia && window.matchMedia('(pointer: coarse)').matches;

    async function copyText(text: string): Promise<boolean> {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        /* fall through to the legacy path */
      }
      // Legacy fallback (older/insecure contexts): hidden textarea + execCommand.
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch {
        return false;
      }
    }

    function flashCopied(btn: HTMLElement): void {
      const labelEl = btn.querySelector<HTMLElement>('.contact-row-btn-label');
      const original = labelEl?.textContent ?? '';
      if (labelEl) labelEl.textContent = COPIED;
      btn.setAttribute('data-copied', 'true');
      if (status) status.textContent = COPIED;
      window.setTimeout(() => {
        if (labelEl) labelEl.textContent = original;
        btn.removeAttribute('data-copied');
        if (status) status.textContent = '';
      }, 1600);
    }

    // ── Adaptive phone button ──────────────────────────────────────────────
    const phoneBtn = panel.querySelector<HTMLAnchorElement>(
      '[data-adaptive-phone]',
    );
    if (phoneBtn && !coarse) {
      // Desktop: turn the tel: link into a copy control.
      const labelEl = phoneBtn.querySelector<HTMLElement>(
        '.contact-row-btn-label',
      );
      const copyLabel = phoneBtn.getAttribute('data-label-copy');
      const ariaCopy = phoneBtn.getAttribute('data-aria-copy');
      if (labelEl && copyLabel) labelEl.textContent = copyLabel;
      if (ariaCopy) phoneBtn.setAttribute('aria-label', ariaCopy);
      phoneBtn.setAttribute('data-action', 'copy');
      phoneBtn.setAttribute('role', 'button');
    }

    // ── Click wiring for all channel controls ──────────────────────────────
    panel
      .querySelectorAll<HTMLElement>('[data-channel]')
      .forEach((el) => {
        el.addEventListener('click', async (e) => {
          const channel = el.getAttribute('data-channel') ?? 'unknown';
          const action = el.getAttribute('data-action') ?? 'open';

          if (action === 'copy') {
            e.preventDefault(); // stop any residual tel:/href navigation
            const text = el.getAttribute('data-copy') ?? '';
            const ok = await copyText(text);
            if (ok) flashCopied(el);
            capture('contact_click', {
              channel,
              action: 'copy',
              source: 'diagnose',
            });
            return;
          }

          // action === 'open' (whatsapp/instagram/linkedin) or 'tel' (mobile phone)
          capture('contact_click', { channel, action, source: 'diagnose' });
        });
      });
  }
</script>

<style>
  /* The panel reuses the form's `.terminal` / `.terminal-head` / `.term-body`
   * base styles (global.css §10) so it reads as a sibling terminal. Only the
   * contact-specific rows are styled here. Tokens only — no literal colors. */

  .contact-terminal {
    /* Fill the deck column / slide height so the two panels align. */
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .contact-body {
    gap: 0.5rem;
    flex: 1 1 auto;
  }

  .contact-intro {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    color: var(--color-dim);
    margin: 0;
    line-height: 1.4;
  }

  /* ── Primary — WhatsApp (emphasized cyan-outline) ─────────────────────────── */
  .contact-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem; /* 44px WCAG tap target */
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-cyan);
    border-radius: 3px;
    background: oklch(from var(--color-cyan) l c h / 0.08);
    box-shadow: 0 0 14px oklch(from var(--color-cyan) l c h / 0.16);
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 200ms,
      box-shadow 200ms,
      transform 200ms;
    outline-offset: 3px;
  }

  .contact-cta:hover {
    background: oklch(from var(--color-cyan) l c h / 0.16);
    box-shadow: 0 0 20px oklch(from var(--color-cyan) l c h / 0.32);
    transform: translateY(-1px);
  }

  .contact-cta:focus-visible {
    outline: 2px solid var(--color-cyan);
  }

  .contact-cta-glyph {
    flex: 0 0 auto;
    display: block;
  }

  /* ── Secondary — channel rows (icon · label/value · action button) ────────── */
  .contact-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--color-cyan-soft);
    border-radius: 3px;
    background: oklch(from var(--color-cyan) l c h / 0.03);
    min-width: 0;
  }

  .contact-row-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cyan);
  }

  .contact-row-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .contact-row-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cyan);
    opacity: 0.75;
    line-height: 1.1;
  }

  .contact-row-value {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
    color: var(--color-fg);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .contact-row-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    min-width: 3.5rem;
    padding: 0.3rem 0.625rem;
    border: 1px solid var(--color-cyan-soft);
    border-radius: 3px;
    background: transparent;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 180ms,
      background 180ms,
      color 180ms;
  }

  .contact-row-btn:hover,
  .contact-row-btn:focus-visible {
    border-color: var(--color-cyan);
    background: oklch(from var(--color-cyan) l c h / 0.1);
    outline: none;
  }

  /* Copy confirmation — brief cyan fill while the label reads "Copiado!". */
  .contact-row-btn[data-copied='true'] {
    border-color: var(--color-cyan);
    background: oklch(from var(--color-cyan) l c h / 0.18);
    color: var(--color-cyan);
  }

  .contact-sr-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Large-screen pass — grow with the panel's scaled type ─────────────────── */
  @media (min-width: 1440px) {
    .contact-cta {
      min-height: 3rem;
      font-size: var(--text-xs);
    }
    .contact-cta-glyph {
      width: 20px;
      height: 20px;
    }
    .contact-row {
      padding: 0.5rem 0.625rem;
    }
    .contact-row-btn {
      min-height: 2.25rem;
    }
  }

  /* ── Short-viewport compaction (action stop must fit 100svh) ─────────────────
   * On short screens tighten gaps + drop the intro line so the panel never
   * pushes the slider chrome out of view. Icons + values still carry every
   * channel; aria-labels keep it fully accessible. */
  @media (max-height: 720px) {
    .contact-body {
      gap: 0.375rem;
    }
    .contact-intro {
      display: none;
    }
    .contact-rows {
      gap: 0.3rem;
    }
    .contact-row {
      padding: 0.3rem 0.5rem;
    }
    .contact-cta {
      min-height: 2.5rem;
    }
  }

  /* Reduced-motion: no lift on the WhatsApp button hover. */
  @media (prefers-reduced-motion: reduce) {
    .contact-cta:hover {
      transform: none;
    }
  }
</style>
