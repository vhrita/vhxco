---
/**
 * ContactCluster.astro — Single, visible contact block for the Diagnose stop.
 *
 * Replaces the old floating WhatsApp FAB (removed on Vitor's feedback). Instead
 * of a persistent floating button, ALL contact channels live in ONE place: next
 * to the DiagnoseForm on the last (action) journey stop. Rendered into the
 * `contact` slot of JourneyStop.astro, so it stacks directly below the terminal
 * form and shares the stop's boot/dolly visibility gates (it lives inside
 * <main>, not as a fixed overlay — no cross-scope global CSS needed).
 *
 * Hierarchy:
 *   - WhatsApp = primary, emphasized (BR-first) — a full-width, prominent
 *     cyan-outline glass button. Distinct from the solid-cyan form submit so the
 *     two never read as duplicate buttons.
 *   - Secondary row: Instagram · LinkedIn · E-mail · Telefone — quiet icon discs
 *     with visible labels + descriptive aria-labels. Support aesthetic; never
 *     competes with the WhatsApp button or the form submit.
 *
 * On-brand: recognizable channel glyphs rendered in the site cyan on dark glass
 * discs (NOT WhatsApp green / IG gradient / LinkedIn blue) — matches the terminal
 * panel. Tokens only (var(--color-cyan) etc.), no literal color values.
 *
 * Analytics: fires the gated `contact_click` PostHog event with
 * { channel, source: 'diagnose' } on click (no-op when PUBLIC_POSTHOG_KEY is
 * absent). Replaces the old FAB's `whatsapp_click`. Metadata only — never field
 * values. See src/lib/analytics/posthog.ts.
 *
 * Responsive: mobile stacks (WhatsApp full-width, then the 4-channel row);
 * ≥44px tap targets everywhere. On short viewports the section label + disc
 * labels collapse so the action stop still fits 100svh (hard law).
 */

import { getT } from '@/lib/i18n/t';
import type { Locale } from '@/lib/i18n/config';

interface Props {
  locale?: 'pt' | 'en';
}

const { locale = 'pt' } = Astro.props;
const t = getT(locale as Locale);

// WhatsApp: pre-encoded sales line, BR-first. Same number as the JSON-LD
// ContactPoint (+5519981952548). PT/EN differ only in the prefilled `text`.
const waHref =
  locale === 'en'
    ? 'https://wa.me/5519981952548?text=Hi!%20I%20came%20from%20the%20VHXCO%20site%20and%20want%20to%20talk%20about%20a%20diagnosis.'
    : 'https://wa.me/5519981952548?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20VHXCO%20e%20quero%20conversar%20sobre%20um%20diagn%C3%B3stico.';

// Secondary channels — same for both locales. `external` links open in a new tab
// with rel=noopener noreferrer; tel/mailto stay in-page.
const channels = [
  {
    id: 'instagram',
    href: 'https://www.instagram.com/vhxcompany/',
    external: true,
    label: t('contact.instagram'),
    aria: t('contact.instagramAria'),
  },
  {
    id: 'linkedin',
    href: 'https://www.linkedin.com/company/vhxcompany/',
    external: true,
    label: t('contact.linkedin'),
    aria: t('contact.linkedinAria'),
  },
  {
    id: 'email',
    href: 'mailto:hello@vhxco.com',
    external: false,
    label: t('contact.email'),
    aria: t('contact.emailAria'),
  },
  {
    id: 'phone',
    href: 'tel:+5519981952548',
    external: false,
    label: t('contact.phone'),
    aria: t('contact.phoneAria'),
  },
] as const;
---

<section class="contact-cluster" aria-label={t('contact.label')}>
  <p class="contact-cluster-label">{t('contact.label')}</p>

  {/* Primary — WhatsApp, emphasized (BR-first) */}
  <a
    class="contact-whatsapp"
    id="contact-whatsapp"
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t('contact.whatsappAria')}
    data-channel="whatsapp"
  >
    <svg
      class="contact-whatsapp-glyph"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.546 4.142 1.588 5.945L0 24l6.335-1.652a11.882 11.882 0 005.71 1.447h.006c6.585 0 11.946-5.36 11.949-11.893a11.821 11.821 0 00-3.481-8.413z"
      ></path>
    </svg>
    <span>{t('contact.whatsapp')}</span>
  </a>

  {/* Secondary — supporting channels, quiet icon discs */}
  <ul class="contact-channels" role="list">
    {channels.map((c) => (
      <li>
        <a
          class="contact-chip"
          href={c.href}
          data-channel={c.id}
          aria-label={c.aria}
          title={c.aria}
          {...(c.external
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <span class="contact-chip-icon" aria-hidden="true">
            {c.id === 'instagram' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
              </svg>
            )}
            {c.id === 'linkedin' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
              </svg>
            )}
            {c.id === 'email' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            )}
            {c.id === 'phone' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            )}
          </span>
          <span class="contact-chip-label">{c.label}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  // Analytics: fire the gated `contact_click` funnel event on any channel click.
  // No-op when PostHog is disabled (no key). Metadata only (channel + source) —
  // never field values. Replaces the old FAB `whatsapp_click`.
  import { capture } from '@/lib/analytics/posthog';

  const cluster = document.querySelector('.contact-cluster');
  cluster?.querySelectorAll<HTMLAnchorElement>('a[data-channel]').forEach((a) => {
    a.addEventListener('click', () => {
      capture('contact_click', {
        channel: a.dataset.channel ?? 'unknown',
        source: 'diagnose',
      });
    });
  });
</script>

<style>
  .contact-cluster {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1.4svh, 0.75rem);
    margin-top: clamp(0.5rem, 1.4svh, 0.875rem);
  }

  /* Section label — quiet cue that ties the block to the form above. */
  .contact-cluster-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cyan);
    opacity: 0.7;
    margin: 0;
    line-height: 1;
  }

  /* ── Primary — WhatsApp (emphasized) ─────────────────────────────────────────
   * Bold cyan-outline glass button: prominent BR-first channel, but visually
   * distinct from the solid-cyan form submit so the two never duplicate. */
  .contact-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem; /* 44px — WCAG tap target */
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-cyan);
    border-radius: 4px;
    background: oklch(from var(--color-cyan) l c h / 0.08);
    box-shadow: 0 0 14px oklch(from var(--color-cyan) l c h / 0.18);
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 200ms,
      box-shadow 200ms,
      transform 200ms;
    outline-offset: 3px;
  }

  .contact-whatsapp:hover {
    background: oklch(from var(--color-cyan) l c h / 0.16);
    box-shadow: 0 0 20px oklch(from var(--color-cyan) l c h / 0.35);
    transform: translateY(-1px);
  }

  .contact-whatsapp:focus-visible {
    outline: 2px solid var(--color-cyan);
  }

  .contact-whatsapp-glyph {
    flex: 0 0 auto;
    display: block;
  }

  /* ── Secondary — supporting channels (quiet discs + labels) ────────────────── */
  .contact-channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(0.375rem, 2vw, 0.75rem);
  }

  .contact-channels > li {
    flex: 1 1 0;
    min-width: 0;
  }

  .contact-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem; /* 44px tap target (disc + label together exceed it) */
    padding: 0.375rem 0.25rem;
    border: 1px solid var(--color-cyan-soft);
    border-radius: 4px;
    background: oklch(from var(--color-cyan) l c h / 0.03);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 200ms,
      background 200ms;
  }

  .contact-chip:hover,
  .contact-chip:focus-visible {
    border-color: var(--color-cyan);
    background: oklch(from var(--color-cyan) l c h / 0.1);
    outline: none;
  }

  .contact-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cyan);
  }

  .contact-chip-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--color-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    line-height: 1;
  }

  /* ── Large-screen pass — grow to match the panel's scaled type ─────────────── */
  @media (min-width: 1440px) {
    .contact-whatsapp {
      min-height: 3rem;
      font-size: var(--text-sm, 0.9375rem);
    }
    .contact-whatsapp-glyph {
      width: 22px;
      height: 22px;
    }
    .contact-chip {
      min-height: 3rem;
      gap: 0.375rem;
    }
    .contact-chip-label {
      font-size: 0.75rem;
    }
  }

  /* ── Short-viewport compaction (hard law: action stop must fit 100svh) ───────
   * On short screens (e.g. 375×667) drop the section label + the disc text
   * labels and tighten gaps so the cluster never pushes the form out of view.
   * The icons + WhatsApp label still carry every channel; aria-labels keep it
   * fully accessible. */
  @media (max-height: 760px) {
    .contact-cluster {
      gap: 0.375rem;
      margin-top: 0.375rem;
    }
    .contact-cluster-label {
      display: none;
    }
    .contact-chip-label {
      display: none;
    }
    /* Tap targets stay >=44px (min-height inherited) — only the text labels and
     * padding shrink to reclaim vertical space on the tight action stop. */
    .contact-chip {
      padding: 0.25rem;
    }
    .contact-whatsapp {
      padding: 0.5rem 1rem;
    }
  }

  /* Reduced-motion: no lift on hover (glow still confirms interactivity). */
  @media (prefers-reduced-motion: reduce) {
    .contact-whatsapp:hover {
      transform: none;
    }
  }
</style>
