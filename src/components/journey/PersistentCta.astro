---
/**
 * PersistentCta.astro — Always-visible "Diagnosticar" CTA (V1 signature).
 *
 * Ported from feature/refactor-mockups PersistentCta.astro.
 * Key differences from the mockup:
 *   - href="#stop-acao" replaced with button that dispatches hud:goto-phase.
 *     journey-input.ts handles the event internally (setJourneyProgress to
 *     stopProgress(4)). CustomEvent payload: { detail: { phase: 4 } }.
 *   - Hides when activeStop === 4 (already at the action stop — no CTA needed).
 *     Visibility driven by body[data-active-stop] in global.css (must be global
 *     to cross component scope boundaries, same constraint as JourneyStop).
 *
 * ADR-0020 §5 Eixo B: CTA persistente — always accessible shortcut for visitors
 * who arrived decided. Intentionally subtle (small pill, escape-hatch feel).
 *
 * Locale: locale prop for aria-label and button text.
 */

interface Props {
  locale?: 'pt' | 'en';
}

const { locale = 'pt' } = Astro.props;

const label = locale === 'en'
  ? 'Go to diagnostic form'
  : 'Ir para o formulário de diagnóstico';

const ctaText = locale === 'en' ? 'Diagnose →' : 'Diagnosticar →';
---

<button
  class="persistent-cta"
  id="persistent-cta"
  aria-label={label}
  type="button"
>
  {ctaText}
</button>

<script>
  // Wire to hud:goto-phase event (journey-input.ts handles internally).
  // CustomEvent payload: { detail: { phase: 4 } } — same as TopNav click.
  const btn = document.getElementById('persistent-cta');

  if (btn) {
    btn.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('hud:goto-phase', { detail: { phase: 4 } }),
      );
    });
  }
</script>

<style>
  .persistent-cta {
    position: fixed;
    bottom: 1.75rem;
    right: 1.5rem;
    /* z-index 25: above content (--z-content=10), below chrome overlays (30+) */
    z-index: 25;

    display: inline-flex;
    align-items: center;
    gap: 0.375rem;

    font-family: var(--font-mono);
    font-size: 0.625rem; /* 10px — escape-hatch, not hero element */
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;

    color: var(--color-cyan);
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid var(--color-cyan);
    padding: 0.4375rem 0.75rem;
    border-radius: 2px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);

    transition:
      background 200ms,
      opacity 200ms;
    white-space: nowrap;
    outline-offset: 4px;
  }

  .persistent-cta:hover {
    background: rgba(94, 234, 255, 0.1);
  }

  .persistent-cta:focus-visible {
    outline: 2px solid var(--color-cyan);
  }
</style>
