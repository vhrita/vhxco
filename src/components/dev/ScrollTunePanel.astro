---
// TEMP: scroll tuning panel — remove before ship
//
// A throwaway, DEV-only floating panel that drives window.__scrollTune (exposed by
// journey-input.ts). Gated TWICE:
//   1. Build-time: the panel body runs under `if (import.meta.env.DEV)`, so Astro/
//      Vite dead-code-eliminates it from the prod bundle (verified: zero __scrollTune
//      refs in `astro build` dist output — only an inert empty <div hidden> remains).
//   2. Runtime: it self-hides unless the URL has ?tune=1, so a dev/QA visiting the
//      dev deploy without the flag sees a completely normal site (nothing mounts).
//
// It only EXPOSES the four existing knobs — no input logic lives here. Delete this
// file + the two lines in BaseLayout.astro that import/render it to fully remove.
//
// Vitor: mexa os sliders ao vivo, copie o bloco de readout, e me passe os 4 números.
---

<div id="scroll-tune-panel" hidden aria-hidden="true"></div>

<script>
  // TEMP: scroll tuning panel — remove before ship
  // Build-time gate: this whole block is stripped from the prod bundle by Vite's
  // dead-code elimination on the false branch of import.meta.env.DEV.
  if (import.meta.env.DEV) {
    // Runtime gate: only mount when ?tune=1 is present.
    const params = new URLSearchParams(window.location.search);
    if (params.get('tune') === '1') {
      type Dial = {
        key: 'wheelStepThreshold' | 'settleMs' | 'settleDamp' | 'cameraTweenMs';
        label: string;
        min: number;
        max: number;
        step: number;
      };
      const DIALS: Dial[] = [
        { key: 'wheelStepThreshold', label: 'threshold (scroll/parada)', min: 60, max: 500, step: 10 },
        { key: 'settleMs', label: 'settleMs (stick dur.)', min: 0, max: 800, step: 20 },
        { key: 'settleDamp', label: 'settleDamp (stick força)', min: 0.1, max: 1.0, step: 0.05 },
        { key: 'cameraTweenMs', label: 'cameraTweenMs (glide)', min: 150, max: 1200, step: 25 },
      ];

      type Tune = Record<Dial['key'], number> & { reset(): void };

      // window.__scrollTune is set by journey-input.ts once createJourneyInput mounts.
      // That import is async (dynamic import in BaseLayout), so poll briefly for it.
      const whenReady = (cb: (t: Tune) => void): void => {
        const w = window as unknown as { __scrollTune?: Tune };
        if (w.__scrollTune) return cb(w.__scrollTune);
        let tries = 0;
        const id = setInterval(() => {
          if (w.__scrollTune) {
            clearInterval(id);
            cb(w.__scrollTune);
          } else if (++tries > 200) {
            clearInterval(id);
            console.warn('[scroll-tune] __scrollTune never appeared');
          }
        }, 25);
      };

      whenReady((tune) => {
        const host = document.getElementById('scroll-tune-panel')!;
        host.hidden = false;
        host.setAttribute('aria-hidden', 'false');
        host.style.cssText = [
          'position:fixed', 'bottom:12px', 'right:12px', 'z-index:2147483647',
          'width:280px', 'padding:12px 12px 10px', 'border-radius:10px',
          'background:rgba(8,8,12,0.86)', 'backdrop-filter:blur(8px)',
          'border:1px solid rgba(255,255,255,0.14)',
          'font:11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace',
          'color:#e8e8ee', 'box-shadow:0 8px 32px rgba(0,0,0,0.5)',
          'user-select:none',
        ].join(';');

        const rows = DIALS.map((d) => {
          const v = tune[d.key];
          return (
            `<div style="margin-bottom:9px">` +
              `<div style="display:flex;justify-content:space-between;margin-bottom:3px">` +
                `<span style="opacity:0.7">${d.label}</span>` +
                `<input data-num="${d.key}" type="number" min="${d.min}" max="${d.max}" step="${d.step}" value="${v}" ` +
                  `style="width:58px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);color:#fff;font:inherit;text-align:right;border-radius:4px;padding:1px 4px" />` +
              `</div>` +
              `<input data-range="${d.key}" type="range" min="${d.min}" max="${d.max}" step="${d.step}" value="${v}" ` +
                `style="width:100%;accent-color:#8b5cf6;margin:0" />` +
            `</div>`
          );
        }).join('');

        host.innerHTML =
          `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">` +
            `<strong style="letter-spacing:0.04em;font-weight:600">SCROLL TUNE <span style="opacity:0.4;font-weight:400">temp</span></strong>` +
            `<button data-reset style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:#fff;font:inherit;border-radius:4px;padding:2px 8px;cursor:pointer">reset</button>` +
          `</div>` +
          rows +
          `<div style="margin-top:6px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.1)">` +
            `<div style="opacity:0.55;margin-bottom:3px">readout (copie e me passe):</div>` +
            `<code data-readout style="display:block;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:4px 6px;color:#a5f3d0;word-break:break-all;cursor:copy" title="clique pra copiar"></code>` +
          `</div>`;

        const readout = (): string =>
          `threshold=${tune.wheelStepThreshold} · settle=${tune.settleMs} · damp=${tune.settleDamp} · tween=${tune.cameraTweenMs}`;
        const syncReadout = (): void => {
          host.querySelector('[data-readout]')!.textContent = readout();
        };

        const apply = (key: Dial['key'], raw: string): void => {
          const d = DIALS.find((x) => x.key === key)!;
          let n = parseFloat(raw);
          if (isNaN(n)) return;
          n = Math.max(d.min, Math.min(d.max, n));
          // damp keeps 2 decimals; the rest are integers.
          n = key === 'settleDamp' ? Math.round(n * 100) / 100 : Math.round(n);
          tune[key] = n; // <-- live mutation of window.__scrollTune → input reads it next event/frame
          (host.querySelector(`[data-num="${key}"]`) as HTMLInputElement).value = String(n);
          (host.querySelector(`[data-range="${key}"]`) as HTMLInputElement).value = String(n);
          syncReadout();
        };

        host.querySelectorAll<HTMLInputElement>('[data-range]').forEach((el) => {
          el.addEventListener('input', () => apply(el.getAttribute('data-range') as Dial['key'], el.value));
        });
        host.querySelectorAll<HTMLInputElement>('[data-num]').forEach((el) => {
          el.addEventListener('input', () => apply(el.getAttribute('data-num') as Dial['key'], el.value));
        });
        host.querySelector('[data-reset]')!.addEventListener('click', () => {
          tune.reset();
          DIALS.forEach((d) => {
            (host.querySelector(`[data-num="${d.key}"]`) as HTMLInputElement).value = String(tune[d.key]);
            (host.querySelector(`[data-range="${d.key}"]`) as HTMLInputElement).value = String(tune[d.key]);
          });
          syncReadout();
        });
        host.querySelector('[data-readout]')!.addEventListener('click', () => {
          if (navigator.clipboard) navigator.clipboard.writeText(readout()).catch(() => {});
        });

        syncReadout();
        console.info('[scroll-tune] panel mounted (?tune=1). __scrollTune live:', readout());
      });
    }
  }
</script>
