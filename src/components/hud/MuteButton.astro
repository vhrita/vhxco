---
// MuteButton.astro
// HUD mute toggle for the audio system.
//
// Default state: ♪ (audio on, cyan accent).
// Muted state:   ø (no colour).
//
// Persistence: reads/writes localStorage key "vhxco-mute" (boolean string).
// Audio control: delegates to window.__audioReady.toggle() which is set by
// lazy-init.ts after the first user click. If the user clicks mute before
// the audio module is loaded (unlikely but possible on very fast double-click),
// we store the preference and lazy-init will honour it on first load.
---

<button
  id="muteBtn"
  aria-label="Toggle audio"
  aria-pressed="false"
  title="Toggle audio"
>
  ♪
</button>

<style>
  #muteBtn {
    position: fixed;
    bottom: var(--safe-gap);
    right: var(--safe-x);
    z-index: var(--z-chrome);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-cyan, #00e5ff) 30%, transparent);
    border-radius: 0.375rem;
    color: var(--color-cyan, #00e5ff);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0.375rem 0.6rem;
    transition: color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0.7;
  }

  #muteBtn:hover {
    opacity: 1;
  }

  #muteBtn[aria-pressed='true'] {
    color: var(--color-text-muted, #666);
    border-color: color-mix(in srgb, var(--color-text-muted, #666) 30%, transparent);
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('muteBtn') as HTMLButtonElement | null;
    if (!btn) return;

    // Sync initial visual state from localStorage (before audio module loads)
    const isMuted = localStorage.getItem('vhxco-mute') === 'true';
    if (isMuted) {
      btn.textContent = 'ø';
      btn.setAttribute('aria-pressed', 'true');
    }

    btn.addEventListener('click', (e) => {
      // Prevent this click from triggering the lazy-init listener a second time
      // (lazy-init uses { once: true } so it's already consumed after first click,
      // but belt-and-suspenders: stop propagation only if audio is already ready)
      if ((window as unknown as Record<string, unknown>).__audioReady) {
        e.stopPropagation();
      }

      const audio = (window as unknown as Record<string, unknown>).__audioReady as
        | { toggle: () => boolean; isMuted: () => boolean }
        | undefined;

      if (audio) {
        const nowMuted = audio.toggle();
        _syncButton(nowMuted);
        localStorage.setItem('vhxco-mute', String(nowMuted));
      } else {
        // Audio not loaded yet — toggle preference in localStorage.
        // lazy-init.ts will read it on first click and stay silent if true.
        const current = localStorage.getItem('vhxco-mute') === 'true';
        const next = !current;
        localStorage.setItem('vhxco-mute', String(next));
        _syncButton(next);
      }
    });

    function _syncButton(muted: boolean): void {
      if (!btn) return;
      btn.textContent = muted ? 'ø' : '♪';
      btn.setAttribute('aria-pressed', String(muted));
    }
  })();
</script>
