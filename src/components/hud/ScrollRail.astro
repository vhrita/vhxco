---
/**
 * ScrollRail.astro
 *
 * Vertical scroll progress rail — right side, 5 step dots with labels.
 * Ported from VHXCO.html lines 1659-1667.
 *
 * - Each step button sets aria-current="step" when active
 * - Click → goToPhase(N) via hud:goto-phase custom event
 * - Active dot = filled cyan, completed = filled dim, future = border-only
 * - Keyboard: Tab to focus, Enter/Space to activate
 *
 * TODO(i18n): replace hard-coded labels with t('nav.rail.0..4') when i18n dict ready.
 */

interface Props {
  locale?: 'pt' | 'en';
}

const { locale = 'pt' } = Astro.props;

const steps = [
  { label: 'Núcleo',      en: 'Core' },
  { label: 'Engenharia',  en: 'Engineering' },
  { label: 'Ecossistema', en: 'Ecosystem' },
  { label: 'Prova',       en: 'Proof' },
  { label: 'Diagnose',    en: 'Diagnose' },
] as const;
---

<nav class="scroll-rail" aria-label="Capítulos" id="scroll-rail">
  {steps.map((step, i) => (
    <button
      class="rail-step"
      data-phase={i}
      aria-current={i === 0 ? 'step' : undefined}
      aria-label={`Ir para ${locale === 'en' ? step.en : step.label}`}
    >
      <span class="rail-dot" aria-hidden="true"></span>
      <span class="rail-label">{locale === 'en' ? step.en : step.label}</span>
    </button>
  ))}
</nav>

<script>
  import { subscribePhase } from '@/lib/scroll/phase-orchestrator';

  const steps = document.querySelectorAll<HTMLButtonElement>('.rail-step');

  function setActiveStep(phase: number) {
    steps.forEach((btn, i) => {
      btn.classList.toggle('active', i === phase);
      btn.classList.toggle('completed', i < phase);
      if (i === phase) {
        btn.setAttribute('aria-current', 'step');
      } else {
        btn.removeAttribute('aria-current');
      }
    });
  }

  const unsub = subscribePhase((state) => {
    setActiveStep(state.phase);
  });

  steps.forEach((btn) => {
    btn.addEventListener('click', () => {
      const phase = parseInt(btn.dataset.phase ?? '0', 10);
      window.dispatchEvent(new CustomEvent('hud:goto-phase', { detail: { phase } }));
    });
  });

  document.addEventListener('astro:before-swap', () => unsub(), { once: true });
</script>
