---
/**
 * TopNav.astro
 *
 * Fixed top navigation: VHXCO logo + N chapter buttons + PT/EN lang toggle + MuteButton.
 * Ported from VHXCO.html lines 1643-1657.
 *
 * iter-08 Move B: MuteButton moved from fixed BR corner into this nav row
 * (right-most element, after lang toggle). Eliminates chrome-vs-chrome conflict
 * in bottom-right corner across all viewports.
 *
 * Chapter labels: PT default. i18n dict is empty for now — hard-coded with TODO.
 * Lang toggle: PT → "/" | EN → "/en/" (Astro i18n routing).
 * Active state driven by journey-state subscribeActiveStop (fires only on stop change,
 * not 60fps). Keyboard nav: Tab focus + roving tabindex within tablist.
 *
 * Blueprint §3.3: chapters array is zipped against STOP_COUNT so N is parametrizable.
 * If STOP_COUNT < chapters.length, extra entries are ignored.
 * If STOP_COUNT > chapters.length, generic labels are used for overflow.
 *
 * Fase 4 (marketer): replace chapter labels/slugs from stops.config.ts when copy is ready.
 *
 * TODO(i18n): when pt.json / en.json have nav.chapter.0..N keys, replace
 *             hard-coded labels with t('nav.chapter.N').
 */

import MuteButton from './MuteButton.astro';
import { STOP_COUNT } from '@/lib/neural-engine/hero-anchors';
import { STOP_NAV_LABELS } from '@/lib/journey/stops-content';

interface Props {
  locale?: 'pt' | 'en';
}

const { locale = 'pt' } = Astro.props;

// V1 chapter labels from stops-content.ts (single source of truth for copy).
// Zipped against STOP_COUNT so N remains parametrizable.
const navLabels = STOP_NAV_LABELS[locale as 'pt' | 'en'] ?? STOP_NAV_LABELS.pt;

const chapters = Array.from({ length: STOP_COUNT }, (_, i) => {
  const entry = navLabels[i];
  const num = String(i + 1).padStart(2, '0');
  if (entry) return { num, label: entry.label, short: entry.short };
  // Overflow fallback
  return { num, label: `Stop ${num}`, short: `S${num}` };
});
---

<nav class="topnav" aria-label="Navegação principal">
  <a href="/" class="topnav-logo" aria-label="VHXCO — página inicial">
    <span class="topnav-logo-mark" aria-hidden="true"></span>
    <span class="topnav-logo-text">VHXCO</span>
  </a>

  <div class="topnav-chapters" id="topnav-chapters" role="tablist" aria-label="Capítulos">
    {chapters.map((ch, i) => (
      <button
        class="topnav-chapter"
        data-phase={i}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`phase-panel-${i}`}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="topnav-chapter-num" aria-hidden="true">{ch.num}</span>
        <span class="topnav-chapter-lbl-short" aria-hidden="true">{ch.short}</span>
        <span class="topnav-lbl-full">{ch.label}</span>
      </button>
    ))}
  </div>

  <div class="topnav-lang" aria-label="Idioma">
    <a
      href="/"
      class:list={['topnav-lang-btn', { active: locale === 'pt' }]}
      hreflang="pt"
      aria-label="Português"
      aria-current={locale === 'pt' ? 'true' : undefined}
    >PT</a>
    <a
      href="/en/"
      class:list={['topnav-lang-btn', { active: locale === 'en' }]}
      hreflang="en"
      aria-label="English"
      aria-current={locale === 'en' ? 'true' : undefined}
    >EN</a>
  </div>

  <!-- iter-08 Move B: MuteButton right-most in nav row (D4 resolved) -->
  <MuteButton />
</nav>

<script>
  // Subscribe to activeStop changes (not every t tick — fires only when stop changes).
  // journey-input.ts handles the hud:goto-phase event internally via _onHudGotoPhase.
  import { subscribeActiveStop, getActiveStop } from '@/lib/journey/journey-state';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.topnav-chapter');

  function setActiveChapter(stop: number) {
    buttons.forEach((btn, i) => {
      const isActive = i === stop;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      btn.tabIndex = isActive ? 0 : -1;
    });
  }

  // Initialize from current store state
  setActiveChapter(getActiveStop());

  // Subscribe to activeStop changes (fires only when stop changes, not 60fps)
  const unsub = subscribeActiveStop(() => {
    setActiveChapter(getActiveStop());
  });

  // Click → dispatch hud:goto-phase (journey-input.ts handles this event internally)
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const phase = parseInt(btn.dataset.phase ?? '0', 10);
      window.dispatchEvent(new CustomEvent('hud:goto-phase', { detail: { phase } }));
    });

    // Keyboard: roving tabindex within tablist
    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      const idx = parseInt(btn.dataset.phase ?? '0', 10);
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        const next = buttons[idx + 1];
        if (next) { next.focus(); next.click(); }
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = buttons[idx - 1];
        if (prev) { prev.focus(); prev.click(); }
      }
    });
  });

  document.addEventListener('astro:before-swap', () => unsub(), { once: true });
</script>
