---
// Branded 404 — bilingual, routes the visitor back into the funnel (home).
// Standalone (not BaseLayout) so it stays light and never boots the 3D engine.
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — VHXCO</title>
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#00d7e4" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="notfound">
    <main class="notfound-wrap">
      <img class="notfound-logo" src="/vhxco-logo-nav-light.png" alt="VHXCO" width="220" height="55" />
      <p class="notfound-code">404</p>
      <h1 class="notfound-title">
        Essa página não existe.
        <span lang="en">This page doesn't exist.</span>
      </h1>
      <p class="notfound-sub">
        Mas o gargalo do seu negócio, a gente encontra.
        <span lang="en">But we'll find your business bottleneck.</span>
      </p>
      <a class="notfound-cta" href="/">Voltar ao início · Back home</a>
    </main>

    <style>
      html,
      body.notfound {
        margin: 0;
        min-height: 100vh;
        background: radial-gradient(
          circle at 50% 38%,
          oklch(from var(--color-cyan) l c h / 0.14),
          var(--color-bg) 62%
        );
        color: var(--color-fg);
        font-family: var(--font-display);
      }
      .notfound-wrap {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 2rem 1.5rem;
        text-align: center;
      }
      .notfound-logo {
        height: auto;
        width: 200px;
        margin-bottom: 1rem;
        opacity: 0.95;
      }
      .notfound-code {
        margin: 0;
        font-family: var(--font-mono);
        font-size: clamp(3rem, 12vw, 6rem);
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--color-cyan);
        line-height: 1;
      }
      .notfound-title {
        margin: 0;
        font-size: clamp(1.25rem, 4vw, 1.75rem);
        font-weight: 600;
      }
      .notfound-title span,
      .notfound-sub span {
        display: block;
        color: var(--color-dim);
        font-weight: 400;
        font-size: 0.85em;
        margin-top: 0.25rem;
      }
      .notfound-sub {
        margin: 0;
        max-width: 34ch;
        color: var(--color-dim);
        font-size: 1rem;
      }
      .notfound-cta {
        margin-top: 1rem;
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border: 1px solid var(--color-cyan);
        border-radius: 999px;
        color: var(--color-cyan);
        text-decoration: none;
        font-size: 0.95rem;
        transition:
          background 0.2s ease,
          color 0.2s ease;
      }
      .notfound-cta:hover,
      .notfound-cta:focus-visible {
        background: var(--color-cyan);
        color: var(--color-bg);
      }
    </style>
  </body>
</html>
