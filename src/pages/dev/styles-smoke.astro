---
/**
 * DEV-ONLY smoke page — /dev/styles-smoke
 *
 * Validates design tokens, Tailwind 4 @theme mapping, and cinema CSS effects.
 * This route is intentionally excluded from sitemap.xml via robots meta.
 *
 * NOTE: Astro 5 treats files with `_` prefix as non-routes (excluded from
 * routing entirely — not accessible at all). To keep this page accessible
 * during development while signalling it's dev-only, it lives in src/pages/dev/
 * and uses a noindex meta tag. Remove or gitignore this file before production.
 *
 * Access: pnpm dev → http://localhost:4321/dev/styles-smoke
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="[DEV] Styles Smoke — VHXCO" locale="pt">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <style>
      /* Smoke page local styles — not part of the design system */
      .smoke-wrap {
        min-height: 100vh;
        padding: 48px 40px;
        background: var(--color-bg);
        color: var(--color-fg);
        font-family: var(--font-mono);
      }

      .smoke-title {
        font-size: 10px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-cyan);
        margin-bottom: 48px;
        border-bottom: 1px solid var(--color-line);
        padding-bottom: 16px;
      }

      .section {
        margin-bottom: 64px;
      }

      .section-label {
        font-size: 9px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-dim);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--color-line);
      }

      /* ── Palette swatches ── */
      .swatches {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      .swatch {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: center;
      }

      .swatch-block {
        width: 80px;
        height: 80px;
        border: 1px solid var(--color-line);
      }

      .swatch-name {
        font-size: 8px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-dim);
        text-align: center;
        max-width: 80px;
        word-break: break-all;
      }

      /* ── Typography samples ── */
      .type-row {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 32px;
      }

      .type-sample {
        display: flex;
        align-items: baseline;
        gap: 20px;
      }

      .type-meta {
        font-size: 8px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-dim);
        min-width: 100px;
        flex-shrink: 0;
      }

      /* ── Cinema effects ── */
      .effects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
      }

      .effect-card {
        position: relative;
        height: 120px;
        border: 1px solid var(--color-line);
        overflow: hidden;
        background: rgba(5, 7, 9, 0.5);
      }

      .effect-label {
        position: absolute;
        bottom: 8px;
        left: 8px;
        font-size: 8px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-dim);
        z-index: 200;
      }

      /* ── Animation demos ── */
      .anim-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 32px;
        align-items: center;
      }

      .anim-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .anim-demo-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-cyan);
        animation: pulseDot 1.6s ease-in-out infinite;
      }

      .anim-demo-core {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: transparent;
        border: 1px solid var(--color-cyan);
        box-shadow: 0 0 12px var(--color-cyan-deep);
        animation: pulseCore 1.4s ease-in-out infinite;
      }

      .anim-demo-ring {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px dashed var(--color-dim);
        animation: spin 22s linear infinite;
      }

      .anim-demo-extract {
        width: 80px;
        height: 40px;
        background: rgba(5, 7, 9, 0.5);
        border: 1px solid rgba(94, 234, 255, 0.12);
        animation: extractIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .anim-demo-scroll {
        width: 2px;
        height: 32px;
        background: linear-gradient(to bottom, transparent, var(--color-cyan), transparent);
        transform-origin: top center;
        animation: scrollPulse 2s ease-in-out infinite;
      }

      .anim-label {
        font-size: 8px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-dim);
      }

      /* ── Token table ── */
      .token-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9px;
      }

      .token-table th {
        text-align: left;
        padding: 8px 12px;
        font-size: 8px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-dim);
        border-bottom: 1px solid var(--color-line);
      }

      .token-table td {
        padding: 8px 12px;
        border-bottom: 1px solid var(--color-line);
        color: var(--color-fg);
        letter-spacing: 0.06em;
      }

      .token-table td:first-child {
        color: var(--color-cyan-soft);
      }

      .token-table td:last-child {
        color: var(--color-dim);
        font-size: 8px;
      }
    </style>
  </Fragment>

  <div class="smoke-wrap">
    <!-- Cinema overlays — always visible on this page -->
    <div class="grain" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="scanline" aria-hidden="true"></div>

    <p class="smoke-title">VHXCO / DEV / Styles Smoke — design tokens + cinema CSS validation</p>

    <!-- ── §1 Color palette ── -->
    <section class="section">
      <p class="section-label">01 — color palette (8 tokens)</p>
      <div class="swatches">
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-bg); border-color: rgba(255,255,255,0.2);"></div>
          <span class="swatch-name">--color-bg<br/>#000</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-fg);"></div>
          <span class="swatch-name">--color-fg<br/>#f4f8fb</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-dim);"></div>
          <span class="swatch-name">--color-dim<br/>#6f7d86</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2);"></div>
          <span class="swatch-name">--color-line<br/>rgba(255,255,255,0.08)</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-cyan);"></div>
          <span class="swatch-name">--color-cyan<br/>oklch(0.78 0.18 200)</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-cyan-soft);"></div>
          <span class="swatch-name">--color-cyan-soft<br/>oklch(0.85 0.12 200)</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-cyan-deep);"></div>
          <span class="swatch-name">--color-cyan-deep<br/>oklch(0.55 0.22 215)</span>
        </div>
        <div class="swatch">
          <div class="swatch-block" style="background: var(--color-warn);"></div>
          <span class="swatch-name">--color-warn<br/>oklch(0.78 0.16 60)</span>
        </div>
      </div>
    </section>

    <!-- ── §2 Tailwind utility classes from @theme ── -->
    <section class="section">
      <p class="section-label">02 — tailwind @theme utility classes</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;">
        <span class="text-cyan">text-cyan</span>
        <span class="text-cyan-soft">text-cyan-soft</span>
        <span class="text-cyan-deep">text-cyan-deep</span>
        <span class="text-warn">text-warn</span>
        <span class="text-dim">text-dim</span>
        <span class="text-fg">text-fg</span>
        <span style="background: var(--color-cyan); color: black; padding: 2px 8px;">bg-cyan</span>
        <span style="background: var(--color-warn); color: black; padding: 2px 8px;">bg-warn</span>
        <span style="background: var(--color-dim); color: black; padding: 2px 8px;">bg-dim</span>
      </div>
    </section>

    <!-- ── §3 Typography — Display ── -->
    <section class="section">
      <p class="section-label">03 — typography display (--font-display / Helvetica Neue)</p>
      <div class="type-row">
        <div class="type-sample">
          <span class="type-meta">92px / wt300</span>
          <span style="font-family: var(--font-display); font-size: 92px; font-weight: 300; letter-spacing: -0.025em; line-height: 0.96; color: var(--color-fg);">VHXCO</span>
        </div>
        <div class="type-sample">
          <span class="type-meta">42px / wt300</span>
          <span style="font-family: var(--font-display); font-size: 42px; font-weight: 300; letter-spacing: -0.02em; line-height: 1; color: var(--color-fg);">Agentic <em style="font-style: normal; color: var(--color-cyan);">Software</em></span>
        </div>
        <div class="type-sample">
          <span class="type-meta">32px / wt300</span>
          <span style="font-family: var(--font-display); font-size: 32px; font-weight: 300; letter-spacing: -0.02em; line-height: 1.1; color: var(--color-fg);">Engineering</span>
        </div>
        <div class="type-sample">
          <span class="type-meta">14px / wt600</span>
          <span style="font-family: var(--font-display); font-size: 14px; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase; color: var(--color-fg);">VHXCO</span>
        </div>
      </div>
    </section>

    <!-- ── §4 Typography — Mono ── -->
    <section class="section">
      <p class="section-label">04 — typography mono (--font-mono / JetBrains Mono)</p>
      <div class="type-row">
        <div class="type-sample">
          <span class="type-meta">12px / body</span>
          <span style="font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; line-height: 1.8; color: var(--color-fg);">Workforce. Foundation. Diagnostic.</span>
        </div>
        <div class="type-sample">
          <span class="type-meta">11px / sub</span>
          <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; line-height: 1.6; color: rgba(255,255,255,0.6);">We build software that operates at machine speed.</span>
        </div>
        <div class="type-sample">
          <span class="type-meta">10px / nav</span>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-dim);">Chapter 01 — Core</span>
        </div>
        <div class="type-sample">
          <span class="type-meta">9px / hud</span>
          <span style="font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-dim);">UTC 14:32:07 / NODE 000 / LAT 12MS</span>
        </div>
      </div>
    </section>

    <!-- ── §5 Cinema effects ── -->
    <section class="section">
      <p class="section-label">05 — cinema effects (overlays always on)</p>
      <p style="font-size: 9px; letter-spacing: 0.1em; color: var(--color-dim); margin-bottom: 20px; text-transform: uppercase;">
        grain + vignette + scanline overlays are active on this entire page (check the edges and the noise texture).
      </p>
      <div class="effects-grid">
        <div class="effect-card">
          <div class="grain" style="position: absolute; inset: 0; z-index: 10;"></div>
          <span class="effect-label" style="z-index: 20;">.grain — SVG turbulence</span>
        </div>
        <div class="effect-card">
          <div class="vignette" style="position: absolute; inset: 0; z-index: 10;"></div>
          <span class="effect-label" style="z-index: 20;">.vignette — radial gradient</span>
        </div>
        <div class="effect-card">
          <div class="scanline" style="position: absolute; inset: 0; z-index: 10;"></div>
          <span class="effect-label" style="z-index: 20;">.scanline — CRT lines</span>
        </div>
        <div class="effect-card" id="glitchDemo" style="cursor: pointer;">
          <div id="glitchDemoOverlay" style="position: absolute; inset: 0; opacity: 0;"></div>
          <span class="effect-label">#glitchOverlay — click to trigger</span>
        </div>
      </div>
    </section>

    <!-- ── §6 Keyframe animations ── -->
    <section class="section">
      <p class="section-label">06 — keyframe animations</p>
      <div class="anim-grid">
        <div class="anim-item">
          <div class="anim-demo-dot"></div>
          <span class="anim-label">pulseDot<br/>1.6s infinite</span>
        </div>
        <div class="anim-item">
          <div class="anim-demo-core"></div>
          <span class="anim-label">pulseCore<br/>1.4s infinite</span>
        </div>
        <div class="anim-item">
          <div class="anim-demo-ring"></div>
          <span class="anim-label">spin<br/>22s infinite</span>
        </div>
        <div class="anim-item">
          <div class="anim-demo-scroll"></div>
          <span class="anim-label">scrollPulse<br/>2s infinite</span>
        </div>
        <div class="anim-item">
          <div class="anim-demo-extract" id="extractDemo"></div>
          <span class="anim-label">extractIn<br/>0.55s (click to replay)</span>
        </div>
        <div class="anim-item">
          <span id="scrambleDemo" style="font-size: 14px; color: var(--color-cyan);">scrambleIn (hover)</span>
          <span class="anim-label">scrambleIn<br/>60ms per char</span>
        </div>
      </div>
    </section>

    <!-- ── §7 Token reference table ── -->
    <section class="section">
      <p class="section-label">07 — duration + easing tokens</p>
      <table class="token-table">
        <thead>
          <tr>
            <th>Token</th>
            <th>Value</th>
            <th>Use</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>--dur-fast</td><td>120ms</td><td>Cursor inner, keyboard hover</td></tr>
          <tr><td>--dur-medium-fast</td><td>240ms</td><td>Cursor outer, rail step</td></tr>
          <tr><td>--dur-medium</td><td>400ms</td><td>Ripple, phase reveals</td></tr>
          <tr><td>--dur-medium-slow</td><td>700ms</td><td>Ripple outer, phase panels</td></tr>
          <tr><td>--dur-slow</td><td>1200ms</td><td>Phase transitions, slow reveals</td></tr>
          <tr><td>--dur-ambient</td><td>1600ms</td><td>Pre-bar fill, infinite pulses</td></tr>
          <tr><td>--ease-emphasized</td><td>cubic-bezier(.2,.8,.2,1)</td><td>Default ease — 10+ uses in v0</td></tr>
          <tr><td>--ease-extract</td><td>cubic-bezier(0.16,1,0.3,1)</td><td>Panel entrance (spring)</td></tr>
        </tbody>
      </table>
    </section>

    <!-- ── §8 Z-index stack ── -->
    <section class="section">
      <p class="section-label">08 — z-index stack</p>
      <table class="token-table">
        <thead>
          <tr>
            <th>Token</th>
            <th>Value</th>
            <th>Layer</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>--z-webgl</td><td>1</td><td>Three.js canvas</td></tr>
          <tr><td>--z-hud</td><td>10</td><td>HUD 4-corners, topnav</td></tr>
          <tr><td>--z-content</td><td>20</td><td>Phase panels, extractable</td></tr>
          <tr><td>--z-overlay</td><td>50</td><td>grain, vignette, scanline</td></tr>
          <tr><td>--z-overlay-flash</td><td>101</td><td>#preFlash (boot completion)</td></tr>
          <tr><td>--z-cursor</td><td>9999</td><td>Custom cursor always on top</td></tr>
        </tbody>
      </table>
    </section>
  </div>

  <!-- Interactive demos (minimal JS — smoke page only) -->
  <script>
    // Glitch overlay demo
    const glitchDemo = document.getElementById('glitchDemo');
    const glitchDemoOverlay = document.getElementById('glitchDemoOverlay');
    if (glitchDemo && glitchDemoOverlay) {
      glitchDemo.addEventListener('click', () => {
        glitchDemoOverlay.style.opacity = '1';
        glitchDemoOverlay.style.background =
          'linear-gradient(90deg, rgba(94,234,255,0.15) 0%, transparent 20%, rgba(255,60,60,0.1) 40%, transparent 60%, rgba(94,234,255,0.1) 80%, transparent 100%)';
        glitchDemoOverlay.style.animation = 'glitchFlash 280ms steps(4) forwards';
        const reset = () => {
          glitchDemoOverlay.style.animation = '';
          glitchDemoOverlay.style.opacity = '0';
          glitchDemoOverlay.removeEventListener('animationend', reset);
        };
        glitchDemoOverlay.addEventListener('animationend', reset);
      });
    }

    // ExtractIn replay
    const extractDemo = document.getElementById('extractDemo');
    if (extractDemo) {
      extractDemo.addEventListener('click', () => {
        extractDemo.style.animation = 'none';
        // Trigger reflow
        void extractDemo.offsetWidth;
        extractDemo.style.animation = 'extractIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards';
      });
    }

    // ScrambleIn hover demo
    const scrambleDemo = document.getElementById('scrambleDemo');
    if (scrambleDemo) {
      const text = scrambleDemo.textContent ?? '';
      scrambleDemo.addEventListener('mouseenter', () => {
        scrambleDemo.innerHTML = '';
        for (const char of text) {
          const span = document.createElement('span');
          span.className = 'scramble-char';
          span.textContent = char;
          scrambleDemo.appendChild(span);
        }
      });
    }
  </script>
</BaseLayout>
