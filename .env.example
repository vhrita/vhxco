# VHXCO Website — environment variables example
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is gitignored.

# Canonical site URL — gates indexability. ONLY "https://vhxco.com" produces an
# indexable build; any other value (or unset, e.g. the sslip.io preview) makes
# every page emit <meta name="robots" content="noindex, nofollow">.
# Prod deploy MUST pass PUBLIC_SITE_URL=https://vhxco.com as a build arg.
PUBLIC_SITE_URL=https://vhxco.com

# Formspree form ID for the Diagnose contact form (Phase 05).
# Get from: https://formspree.io/forms → create a new form → copy the ID (e.g. "xqakeyzv").
# Used by src/components/forms/DiagnoseForm.tsx
PUBLIC_FORMSPREE_ID=<get-from-formspree-dashboard>

# PostHog analytics (funnel measurement). EU Cloud.
# Init is GATED: with no key the whole analytics layer is a silent no-op.
# Used by src/lib/analytics/posthog.ts (init) + funnel event callers.
# Get the key from the PostHog project settings (EU cloud).
PUBLIC_POSTHOG_KEY=<get-from-posthog-project-settings>
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
